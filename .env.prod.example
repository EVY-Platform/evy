# Production-only variables (Traefik reverse proxy / TLS) for a self-hosted
# deployment with `docker-compose.prod.yml`. Not needed for local dev or CI —
# `docker-compose.yml` and every workflow only ever read `.env.example`/`.env`.
#
# `docker compose` only auto-loads a file literally named `.env` next to the
# compose file, so on the production server merge this file into the base
# `.env` before running `docker-compose.prod.yml`, e.g.:
#   cat .env.example .env.prod.example > .env   # then fill in real values
# or pass both explicitly with repeated --env-file flags:
#   docker compose --env-file .env --env-file .env.prod -f docker-compose.prod.yml up

# Domain Configuration
DOMAIN=localhost
EMAIL=my@email.com

# Traefik Configuration
CERT_RESOLVER=le
TRAEFIK_USER=admin
TRAEFIK_PASSWORD_HASH='my_hash'
