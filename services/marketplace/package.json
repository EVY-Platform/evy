{
	"name": "evy-marketplace",
	"version": "0.0.1",
	"description": "Evy marketplace service",
	"license": "GPL-3.0-only",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"dev": "bun --env-file=../../.env --watch src/index.ts",
		"build": "bun build src/index.ts --outdir dist --target bun",
		"start": "bun run db:migrate && bun --env-file=../../.env src/index.ts",
		"health": "bun src/readiness.ts",
		"health:seeded": "bun src/readiness.ts --require-seeded",
		"test:unit": "bun --env-file=../../.env test src/ --preload ./src/tests/sharedTestDb.ts --serial",
		"test:e2e": "bun --env-file=../../.env test e2e/",
		"lint": "bunx biome check",
		"format": "bunx biome check --write .",
		"db:generate": "bun --env-file=../../.env drizzle-kit generate",
		"db:migrate": "bun --env-file=../../.env drizzle-kit migrate",
		"db:push": "bun --env-file=../../.env drizzle-kit push",
		"db:studio": "bun --env-file=../../.env drizzle-kit studio"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.1",
		"@types/node": "^25.9.3",
		"@types/ws": "^8.18.1",
		"bun-types": "^1.3.14",
		"drizzle-kit": "^0.31.10"
	},
	"dependencies": {
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"drizzle-orm": "^0.45.2",
		"evy-types": "file:../../types",
		"postgres": "^3.4.9",
		"rpc-websockets": "^10.0.1"
	}
}
