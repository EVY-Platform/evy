# API Configuration
API_PORT=8000
API_HOST=localhost:$API_PORT
API_URL=ws://$API_HOST

# Marketplace service (internal JSON-RPC WebSocket; main API forwards marketplace `service` here).
# Docker Compose: use the compose service name so the api container can resolve it (`marketplace`).
# Local processes on the host (api + marketplace both via `bun run dev`): use `127.0.0.1` for both
# dial (API) and listen (marketplace)—never use `0.0.0.0` as the API's WebSocket client target.
# These are the fallback: the API prefers ws_host/ws_port on the service's row in
# the Service table, and only reads <NAME>_WS_HOST/<NAME>_WS_PORT when the row
# has no endpoint. `bun run db:seed` copies these values onto the row.
MARKETPLACE_WS_HOST=marketplace
MARKETPLACE_WS_PORT=8001

# Comma-separated service names that must have a resolvable endpoint for the API
# to report ready. Unlisted services only warn, so one misconfigured optional
# service cannot take the gateway out of rotation. Empty means none are required.
# REQUIRED_SERVICES=marketplace

# How long the API waits for a forwarded service call before failing with an
# attributed timeout error. Defaults to 10000.
# SERVICE_RPC_TIMEOUT_MS=10000

# Web Configuration
WEB_PORT=3003

# Database Configuration
DB_USER=evy
DB_PASS=evy
DB_PORT=5432
DB_DOMAIN=localhost
DB_EVY_DATABASE=evy
DB_MARKETPLACE_DATABASE=marketplace

GOOGLE_PLACES_API_KEY='googlekey' # placeholder; see PLACEHOLDER_GOOGLE_PLACES_API_KEY in api/src/procedures/placeSearch.ts
# When true, place search uses in-process fixtures (e2e and local dev with the placeholder key).
# When unset, the placeholder key above also selects the mock; set to false with a real key for live Google Places.
GOOGLE_PLACES_MOCK=

STRIPE_SECRET_KEY='stripekey' # placeholder; see PLACEHOLDER_STRIPE_SECRET_KEY in api/src/procedures/stripeGateway.ts
STRIPE_ACCOUNT_ID=acct_1U01dqFWaBhHEoAs
# Signing secret from `stripe listen --forward-to localhost:8002/webhooks/stripe` (test mode only).
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_PORT=8002
# When true, payment intent/capture use in-process fixtures (e2e and local dev with the placeholder key).
# When unset, the placeholder key above also selects the mock; set to false with a real sk_test_ key for live Stripe sandbox.
STRIPE_MOCK=

# Production-only (Traefik/domain) variables live in `.env.prod.example` — see that
# file's header for how they combine with this one for `docker-compose.prod.yml`.
