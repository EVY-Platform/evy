{
	"compilerOptions": {
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"target": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["bun-types"],
		"baseUrl": ".",
		"paths": {
			"evy-types": ["../types/generated/ts/index.ts"],
			"evy-types/*": ["../types/generated/ts/*.ts"],
			"evy-types/coreResources": [
				"../types/generated/ts/coreResources.ts"
			],
			"evy-types/marketplaceResources": [
				"../types/generated/ts/marketplaceResources.ts"
			]
		}
	},
	"include": ["app/**/*", "dev/**/*", "tests/**/*"]
}
