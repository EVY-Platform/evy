{
	"compilerOptions": {
		"module": "ESNext",
		"target": "ESNext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["bun-types"],
		"baseUrl": ".",
		"paths": {
			"evy-types": [
				"../types/generated/ts/index.ts",
				"./types/generated/ts/index.ts"
			],
			"evy-types/*": [
				"../types/generated/ts/*.ts",
				"./types/generated/ts/*.ts"
			],
			"evy-types/validators": [
				"../types/validators.ts",
				"./types/validators.ts"
			],
			"evy-types/rpcRequestHelpers": [
				"../types/rpcRequestHelpers.ts",
				"./types/rpcRequestHelpers.ts"
			],
			"evy-types/coreResources": [
				"../types/generated/ts/coreResources.ts",
				"./types/generated/ts/coreResources.ts"
			],
			"evy-types/marketplaceResources": [
				"../types/generated/ts/marketplaceResources.ts",
				"./types/generated/ts/marketplaceResources.ts"
			],
			"drizzle-orm": ["./node_modules/drizzle-orm"],
			"drizzle-orm/*": ["./node_modules/drizzle-orm/*"]
		}
	},
	"include": ["src/**/*", "e2e/**/*"]
}
