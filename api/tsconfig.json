{
	"compilerOptions": {
		"module": "ESNext",
		"target": "ESNext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["bun-types"],
		"baseUrl": ".",
		"paths": {
			"drizzle-orm": ["./node_modules/drizzle-orm"],
			"drizzle-orm/*": ["./node_modules/drizzle-orm/*"]
		}
	},
	"include": ["src/**/*", "e2e/**/*"]
}
