{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "message",
	"title": "DATA_EVY_Message",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"id",
		"fk",
		"service",
		"resource",
		"createdAt",
		"status",
		"data"
	],
	"properties": {
		"id": { "type": "string", "format": "uuid" },
		"fk": { "type": "string", "format": "uuid" },
		"service": { "type": "string", "format": "uuid" },
		"resource": { "type": "string", "format": "uuid" },
		"archivedAt": {
			"type": ["string", "null"],
			"format": "date-time"
		},
		"createdAt": { "type": "string", "format": "date-time" },
		"status": {
			"type": "string",
			"enum": ["pending", "accepted"]
		},
		"data": {
			"type": "object",
			"additionalProperties": {
				"$ref": "../common/json.schema.json#/$defs/JSONValue"
			}
		}
	}
}
