{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "request",
	"title": "DATA_EVY_Request",
	"type": "object",
	"additionalProperties": false,
	"required": ["id", "fk", "service", "resource", "createdAt", "data"],
	"properties": {
		"id": { "type": "string", "format": "uuid" },
		"fk": { "type": "string", "format": "uuid" },
		"service": { "type": "string", "format": "uuid" },
		"resource": { "type": "string", "format": "uuid" },
		"archivedAt": {
			"type": ["string", "null"],
			"format": "date-time"
		},
		"createdAt": { "type": "string", "format": "date-time" },
		"data": {
			"type": "object",
			"additionalProperties": {
				"$ref": "../common/json.schema.json#/$defs/JSONValue"
			}
		}
	}
}
