{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "data",
	"title": "DATA_EVY_Rows",
	"description": "API persistence row types: DATA_EVY_Flow, DATA_EVY_Device, DATA_EVY_Service, etc. Date-time fields use ISO 8601 / RFC 3339 strings (format date-time), not Unix timestamps; Drizzle maps them to Postgres text columns.",
	"oneOf": [
		{
			"$ref": "#/$defs/DATA_EVY_Flow"
		},
		{
			"$ref": "#/$defs/DATA_EVY_Page"
		},
		{
			"$ref": "#/$defs/DATA_EVY_Row"
		},
		{
			"$ref": "#/$defs/DATA_EVY_Transaction"
		},
		{
			"$ref": "#/$defs/DATA_EVY_Device"
		},
		{
			"$ref": "#/$defs/DATA_EVY_Service"
		},
		{
			"$ref": "#/$defs/DATA_EVY_Organization"
		},
		{
			"$ref": "#/$defs/DATA_EVY_ServiceProvider"
		},
		{
			"$ref": "#/$defs/DATA_EVY_File"
		},
		{
			"$ref": "#/$defs/DATA_EVY_Address"
		},
		{
			"$ref": "#/$defs/DATA_EVY_Message"
		},
		{
			"$ref": "#/$defs/DATA_EVY_Formatter"
		}
	],
	"$defs": {
		"DATA_EVY_Address": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "created_at", "updated_at", "visibility"],
			"properties": {
				"id": {
					"type": "string",
					"format": "uuid"
				},
				"unit": {
					"type": "string"
				},
				"street": {
					"type": "string"
				},
				"city": {
					"type": "string"
				},
				"postcode": {
					"type": "string"
				},
				"state": {
					"type": "string"
				},
				"country": {
					"type": "string"
				},
				"latitude": {
					"type": "number"
				},
				"longitude": {
					"type": "number"
				},
				"instructions": {
					"type": "string"
				},
				"visibility": {
					"$ref": "#/$defs/visibility"
				},
				"created_at": {
					"type": "string",
					"format": "date-time"
				},
				"updated_at": {
					"type": "string",
					"format": "date-time"
				},
				"deleted_at": {
					"description": "Set when the record is deleted. Tombstoned rows are excluded from plain reads but included in incremental ones, so clients learn about deletions.",
					"type": "string",
					"format": "date-time"
				}
			}
		},
		"visibility": {
			"type": "string",
			"enum": ["public", "private"]
		},
		"DATA_EVY_Formatter": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"name",
				"formatting_config",
				"formatting",
				"created_at",
				"updated_at"
			],
			"properties": {
				"id": {
					"type": "string",
					"format": "uuid"
				},
				"name": {
					"type": "string",
					"minLength": 1
				},
				"formatting_config": {
					"type": "string",
					"minLength": 1
				},
				"formatting": {
					"type": "object",
					"additionalProperties": {
						"type": "string"
					}
				},
				"created_at": {
					"type": "string",
					"format": "date-time"
				},
				"updated_at": {
					"type": "string",
					"format": "date-time"
				},
				"deleted_at": {
					"description": "Set when the record is deleted. Tombstoned rows are excluded from plain reads but included in incremental ones, so clients learn about deletions.",
					"type": "string",
					"format": "date-time"
				}
			}
		},
		"DATA_EVY_Message": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"fk",
				"resource",
				"type",
				"value",
				"created_at",
				"updated_at",
				"data",
				"visibility"
			],
			"properties": {
				"id": {
					"type": "string",
					"format": "uuid"
				},
				"fk": {
					"type": "string",
					"format": "uuid"
				},
				"resource": {
					"$ref": "../common/rpc.schema.json#/$defs/ResourceRef"
				},
				"type": {
					"type": "string"
				},
				"value": {
					"type": "string"
				},
				"created_at": {
					"type": "string",
					"format": "date-time"
				},
				"updated_at": {
					"type": "string",
					"format": "date-time"
				},
				"deleted_at": {
					"description": "Set when the record is deleted. Tombstoned rows are excluded from plain reads but included in incremental ones, so clients learn about deletions.",
					"type": "string",
					"format": "date-time"
				},
				"data": {
					"type": "object",
					"additionalProperties": {
						"$ref": "../common/json.schema.json#/$defs/JSONValue"
					}
				},
				"parent_message_id": {
					"type": "string",
					"format": "uuid",
					"description": "The id of the message this one answers. Absent on a request; present on accept/reject/cancel. Forms a linked list with the request."
				},
				"visibility": {
					"$ref": "#/$defs/visibility"
				}
			}
		},
		"DATA_EVY_Flow": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"name",
				"page_ids",
				"created_at",
				"updated_at",
				"visibility"
			],
			"properties": {
				"id": {
					"type": "string",
					"format": "uuid"
				},
				"name": {
					"type": "string",
					"minLength": 1
				},
				"page_ids": {
					"type": "array",
					"items": {
						"type": "string",
						"format": "uuid"
					}
				},
				"submits": {
					"$ref": "#/$defs/DATA_EVY_FlowSubmits"
				},
				"visibility": {
					"$ref": "#/$defs/visibility"
				},
				"created_at": {
					"type": "string",
					"format": "date-time"
				},
				"updated_at": {
					"type": "string",
					"format": "date-time"
				},
				"deleted_at": {
					"description": "Set when the record is deleted. Tombstoned rows are excluded from plain reads but included in incremental ones, so clients learn about deletions.",
					"type": "string",
					"format": "date-time"
				}
			}
		},
		"DATA_EVY_FlowSubmits": {
			"description": "Domain entity a flow submits via create(...,submit). Declared so clients validate rather than infer submission semantics from action strings.",
			"type": "object",
			"additionalProperties": false,
			"required": ["resource"],
			"properties": {
				"resource": {
					"$ref": "../common/rpc.schema.json#/$defs/ResourceRef"
				}
			}
		},
		"os": {
			"type": "string",
			"enum": ["ios", "android", "web"]
		},
		"DATA_EVY_Device": {
			"type": "object",
			"additionalProperties": false,
			"required": ["token", "os", "created_at", "visibility"],
			"properties": {
				"token": {
					"type": "string",
					"maxLength": 256
				},
				"os": {
					"$ref": "#/$defs/os"
				},
				"visibility": {
					"$ref": "#/$defs/visibility"
				},
				"created_at": {
					"type": "string",
					"format": "date-time"
				}
			}
		},
		"DATA_EVY_Service": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"name",
				"description",
				"created_at",
				"updated_at",
				"visibility"
			],
			"properties": {
				"id": {
					"$ref": "../common/rpc.schema.json#/$defs/ServiceSlug"
				},
				"name": {
					"type": "string",
					"maxLength": 50
				},
				"description": {
					"type": "string"
				},
				"ws_host": {
					"description": "WebSocket host the API dials for this service. Falls back to the <NAME>_WS_HOST env var when unset.",
					"type": "string",
					"maxLength": 253
				},
				"ws_port": {
					"description": "WebSocket port paired with ws_host. Falls back to <NAME>_WS_PORT when unset.",
					"type": "integer",
					"minimum": 1,
					"maximum": 65535
				},
				"sort_order": {
					"type": "integer"
				},
				"visibility": {
					"$ref": "#/$defs/visibility"
				},
				"created_at": {
					"type": "string",
					"format": "date-time"
				},
				"updated_at": {
					"type": "string",
					"format": "date-time"
				},
				"deleted_at": {
					"description": "Set when the record is deleted. Tombstoned rows are excluded from plain reads but included in incremental ones, so clients learn about deletions.",
					"type": "string",
					"format": "date-time"
				}
			}
		},
		"DATA_EVY_Organization": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"name",
				"description",
				"logo",
				"url",
				"support_email",
				"created_at",
				"updated_at",
				"visibility"
			],
			"properties": {
				"id": {
					"type": "string",
					"format": "uuid"
				},
				"name": {
					"type": "string",
					"maxLength": 100
				},
				"description": {
					"type": "string"
				},
				"logo": {
					"type": "string",
					"format": "uuid"
				},
				"url": {
					"type": "string",
					"maxLength": 50
				},
				"support_email": {
					"type": "string",
					"maxLength": 50
				},
				"visibility": {
					"$ref": "#/$defs/visibility"
				},
				"created_at": {
					"type": "string",
					"format": "date-time"
				},
				"updated_at": {
					"type": "string",
					"format": "date-time"
				},
				"deleted_at": {
					"description": "Set when the record is deleted. Tombstoned rows are excluded from plain reads but included in incremental ones, so clients learn about deletions.",
					"type": "string",
					"format": "date-time"
				}
			}
		},
		"DATA_EVY_ServiceProvider": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"fk_service_id",
				"fk_organization_id",
				"name",
				"description",
				"logo",
				"url",
				"created_at",
				"updated_at",
				"retired",
				"visibility"
			],
			"properties": {
				"id": {
					"type": "string",
					"format": "uuid"
				},
				"fk_service_id": {
					"$ref": "../common/rpc.schema.json#/$defs/ServiceSlug"
				},
				"fk_organization_id": {
					"type": "string",
					"format": "uuid"
				},
				"name": {
					"type": "string",
					"maxLength": 100
				},
				"description": {
					"type": "string"
				},
				"logo": {
					"type": "string",
					"format": "uuid"
				},
				"url": {
					"type": "string",
					"maxLength": 50
				},
				"visibility": {
					"$ref": "#/$defs/visibility"
				},
				"created_at": {
					"type": "string",
					"format": "date-time"
				},
				"updated_at": {
					"type": "string",
					"format": "date-time"
				},
				"deleted_at": {
					"description": "Set when the record is deleted. Tombstoned rows are excluded from plain reads but included in incremental ones, so clients learn about deletions.",
					"type": "string",
					"format": "date-time"
				},
				"retired": {
					"type": "boolean",
					"default": false
				}
			}
		},
		"DATA_EVY_File": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"type",
				"created_at",
				"updated_at",
				"visibility"
			],
			"properties": {
				"id": {
					"type": "string",
					"format": "uuid"
				},
				"type": {
					"type": "string",
					"minLength": 1
				},
				"visibility": {
					"$ref": "#/$defs/visibility"
				},
				"created_at": {
					"type": "string",
					"format": "date-time"
				},
				"updated_at": {
					"type": "string",
					"format": "date-time"
				},
				"deleted_at": {
					"description": "Set when the record is deleted. Tombstoned rows are excluded from plain reads but included in incremental ones, so clients learn about deletions.",
					"type": "string",
					"format": "date-time"
				}
			}
		},
		"DATA_EVY_Page": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"name",
				"row_ids",
				"created_at",
				"updated_at",
				"visibility"
			],
			"properties": {
				"id": {
					"type": "string",
					"format": "uuid"
				},
				"name": {
					"type": "string",
					"minLength": 1
				},
				"title": {
					"type": "string"
				},
				"row_ids": {
					"type": "array",
					"items": {
						"type": "string",
						"format": "uuid"
					}
				},
				"footer_row_id": {
					"type": "string",
					"format": "uuid"
				},
				"visibility": {
					"$ref": "#/$defs/visibility"
				},
				"created_at": {
					"type": "string",
					"format": "date-time"
				},
				"updated_at": {
					"type": "string",
					"format": "date-time"
				},
				"deleted_at": {
					"description": "Set when the record is deleted. Tombstoned rows are excluded from plain reads but included in incremental ones, so clients learn about deletions.",
					"type": "string",
					"format": "date-time"
				}
			}
		},
		"DATA_EVY_RowData": {
			"description": "Row payload. Unknown keys are unconstrained JSON. `additionalProperties: true` rather than a JSONValue $ref: the ref renders as a closed TypeScript index signature that conflicts with the typed properties below (a property may be undefined, which the JSONValue union excludes), while `true` renders `[k: string]: unknown`. Both accept exactly the same wire input.",
			"type": "object",
			"additionalProperties": true,
			"properties": {
				"actions": {
					"description": "Trigger-keyed action lists. Optional for storage, but validated when present so a malformed shape is rejected at write time instead of silently dropping the row on the client.",
					"$ref": "../sdui/evy.schema.json#/$defs/UI_RowActions"
				},
				"sheet_row_id": {
					"type": "string",
					"format": "uuid"
				},
				"children_row_ids": {
					"type": "array",
					"items": {
						"type": "string",
						"format": "uuid"
					}
				}
			}
		},
		"DATA_EVY_Row": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"name",
				"type",
				"visible",
				"data",
				"created_at",
				"updated_at",
				"visibility"
			],
			"properties": {
				"id": {
					"type": "string",
					"format": "uuid"
				},
				"name": {
					"type": "string",
					"minLength": 1
				},
				"type": {
					"type": "string",
					"enum": [
						"button",
						"calendar",
						"horizontal_container",
						"dropdown",
						"heading",
						"text",
						"text_action",
						"text_expand",
						"inline_picker",
						"map",
						"input_list",
						"input",
						"vertical_container",
						"list_item",
						"search",
						"photo_gallery",
						"select_photo",
						"tab_container",
						"text_area",
						"text_select",
						"timeslot_picker"
					]
				},
				"visible": {
					"type": "string"
				},
				"data": {
					"$ref": "#/$defs/DATA_EVY_RowData"
				},
				"visibility": {
					"$ref": "#/$defs/visibility"
				},
				"created_at": {
					"type": "string",
					"format": "date-time"
				},
				"updated_at": {
					"type": "string",
					"format": "date-time"
				},
				"deleted_at": {
					"description": "Set when the record is deleted. Tombstoned rows are excluded from plain reads but included in incremental ones, so clients learn about deletions.",
					"type": "string",
					"format": "date-time"
				}
			}
		},
		"DATA_EVY_TransactionSignature": {
			"type": "object",
			"additionalProperties": false,
			"required": ["data", "hash"],
			"properties": {
				"data": {
					"type": "object",
					"additionalProperties": false,
					"required": [
						"amount",
						"currency",
						"authorization_message_id",
						"created_at",
						"payment_provider",
						"payment_method_last_4_characters"
					],
					"properties": {
						"amount": {
							"type": "number",
							"minimum": 0
						},
						"currency": {
							"type": "string",
							"minLength": 1
						},
						"authorization_message_id": {
							"type": "string",
							"format": "uuid"
						},
						"created_at": {
							"type": "string"
						},
						"payment_provider": {
							"type": "string",
							"enum": ["stripe"]
						},
						"payment_method_last_4_characters": {
							"type": "string",
							"pattern": "^[0-9]{4}$"
						}
					}
				},
				"hash": {
					"type": "string",
					"pattern": "^[0-9a-f]{64}$",
					"description": "Lowercase hex SHA-256 of the canonical signature string (evy-txn-sig-v1)."
				}
			}
		},
		"DATA_EVY_Transaction": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"fk",
				"resource",
				"type",
				"status",
				"amount",
				"currency",
				"payment_provider_fee",
				"service_fee",
				"payment_provider",
				"payment_provider_transaction_id",
				"signature",
				"authorization_message_id",
				"visibility",
				"created_at",
				"updated_at"
			],
			"properties": {
				"id": {
					"type": "string",
					"format": "uuid"
				},
				"fk": {
					"type": "string",
					"format": "uuid",
					"description": "The marketplace item this transaction moves money for."
				},
				"resource": {
					"$ref": "../common/rpc.schema.json#/$defs/ResourceRef"
				},
				"type": {
					"type": "string",
					"enum": ["charge", "transfer"]
				},
				"status": {
					"type": "string",
					"enum": [
						"intent",
						"initiated",
						"succeeded",
						"failed",
						"completed",
						"canceled"
					],
					"description": "Append-only lifecycle state for this type. Each transition is a new row; rows sharing payment_provider_transaction_id form one payment's ledger."
				},
				"amount": {
					"type": "number",
					"minimum": 0,
					"description": "Money moved; 0 allowed."
				},
				"currency": {
					"type": "string",
					"minLength": 1,
					"description": "From the item's price; \"AUD\" in v1."
				},
				"payment_provider_fee": {
					"type": "number",
					"minimum": 0,
					"description": "Provider's cut; always 0 in v1."
				},
				"service_fee": {
					"type": "number",
					"minimum": 0,
					"description": "EVY's cut; always 0 in v1."
				},
				"payment_provider": {
					"type": "string",
					"enum": ["stripe"]
				},
				"payment_provider_transaction_id": {
					"type": "string",
					"minLength": 1,
					"description": "Provider's own id; v1 callers generate a uuid."
				},
				"signature": {
					"$ref": "#/$defs/DATA_EVY_TransactionSignature",
					"description": "Buyer-generated proof of payment origin; verified against the payment method's last-4 before the Stripe intent is created. Copied to every row of the payment's ledger."
				},
				"authorization_message_id": {
					"type": "string",
					"format": "uuid",
					"description": "The buyer's original request (the message stating the price)."
				},
				"error": {
					"type": "string",
					"minLength": 1,
					"description": "Provider-reported failure reason; set only on \"failed\" rows."
				},
				"visibility": {
					"$ref": "#/$defs/visibility"
				},
				"created_at": {
					"type": "string",
					"format": "date-time"
				},
				"updated_at": {
					"type": "string",
					"format": "date-time"
				},
				"deleted_at": {
					"description": "Set when the record is deleted. Tombstoned rows are excluded from plain reads but included in incremental ones, so clients learn about deletions.",
					"type": "string",
					"format": "date-time"
				}
			}
		}
	}
}
