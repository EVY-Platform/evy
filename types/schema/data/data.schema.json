{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "data",
	"title": "DATA_EVY_Rows",
	"description": "API persistence row types: DATA_EVY_Flow, DATA_EVY_Device, DATA_EVY_Service, etc. Date-time fields use ISO 8601 / RFC 3339 strings (format date-time), not Unix timestamps; Drizzle maps them to Postgres text columns.",
	"oneOf": [
		{
			"$ref": "#/$defs/DATA_EVY_Flow"
		},
		{
			"$ref": "#/$defs/DATA_EVY_Page"
		},
		{
			"$ref": "#/$defs/DATA_EVY_Row"
		},
		{
			"$ref": "#/$defs/DATA_EVY_Device"
		},
		{
			"$ref": "#/$defs/DATA_EVY_Service"
		},
		{
			"$ref": "#/$defs/DATA_EVY_Organization"
		},
		{
			"$ref": "#/$defs/DATA_EVY_ServiceProvider"
		},
		{
			"$ref": "#/$defs/DATA_EVY_File"
		},
		{
			"$ref": "#/$defs/DATA_EVY_Address"
		},
		{
			"$ref": "#/$defs/DATA_EVY_Message"
		},
		{
			"$ref": "#/$defs/DATA_EVY_Formatter"
		}
	],
	"$defs": {
		"DATA_EVY_Address": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "createdAt", "updatedAt", "visibility"],
			"properties": {
				"id": {
					"type": "string",
					"format": "uuid"
				},
				"unit": {
					"type": "string"
				},
				"street": {
					"type": "string"
				},
				"city": {
					"type": "string"
				},
				"postcode": {
					"type": "string"
				},
				"state": {
					"type": "string"
				},
				"country": {
					"type": "string"
				},
				"latitude": {
					"type": "number"
				},
				"longitude": {
					"type": "number"
				},
				"instructions": {
					"type": "string"
				},
				"visibility": {
					"$ref": "#/$defs/Visibility"
				},
				"createdAt": {
					"type": "string",
					"format": "date-time"
				},
				"updatedAt": {
					"type": "string",
					"format": "date-time"
				},
				"deletedAt": {
					"description": "Set when the record is deleted. Tombstoned rows are excluded from plain reads but included in incremental ones, so clients learn about deletions.",
					"type": "string",
					"format": "date-time"
				}
			}
		},
		"Visibility": {
			"type": "string",
			"enum": ["public", "private"]
		},
		"DATA_EVY_Formatter": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"name",
				"formatting_config",
				"formatting",
				"createdAt",
				"updatedAt"
			],
			"properties": {
				"id": {
					"type": "string",
					"format": "uuid"
				},
				"name": {
					"type": "string",
					"minLength": 1
				},
				"formatting_config": {
					"type": "string",
					"minLength": 1
				},
				"formatting": {
					"type": "object",
					"additionalProperties": {
						"type": "string"
					}
				},
				"createdAt": {
					"type": "string",
					"format": "date-time"
				},
				"updatedAt": {
					"type": "string",
					"format": "date-time"
				},
				"deletedAt": {
					"description": "Set when the record is deleted. Tombstoned rows are excluded from plain reads but included in incremental ones, so clients learn about deletions.",
					"type": "string",
					"format": "date-time"
				}
			}
		},
		"DATA_EVY_Message": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"fk",
				"service",
				"resource",
				"createdAt",
				"updatedAt",
				"data",
				"visibility"
			],
			"properties": {
				"id": {
					"type": "string",
					"format": "uuid"
				},
				"fk": {
					"type": "string",
					"format": "uuid"
				},
				"service": {
					"type": "string",
					"format": "uuid"
				},
				"resource": {
					"type": "string",
					"format": "uuid"
				},
				"createdAt": {
					"type": "string",
					"format": "date-time"
				},
				"updatedAt": {
					"type": "string",
					"format": "date-time"
				},
				"deletedAt": {
					"description": "Set when the record is deleted. Tombstoned rows are excluded from plain reads but included in incremental ones, so clients learn about deletions.",
					"type": "string",
					"format": "date-time"
				},
				"data": {
					"type": "object",
					"additionalProperties": {
						"$ref": "../common/json.schema.json#/$defs/JSONValue"
					}
				},
				"parentMessageId": {
					"type": "string",
					"format": "uuid",
					"description": "The id of the message this one answers. Absent on a request; present on accept/reject/cancel. Forms a linked list with the request."
				},
				"visibility": {
					"$ref": "#/$defs/Visibility"
				}
			}
		},
		"DATA_EVY_Flow": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"name",
				"pageIds",
				"createdAt",
				"updatedAt",
				"visibility"
			],
			"properties": {
				"id": {
					"type": "string",
					"format": "uuid"
				},
				"name": {
					"type": "string",
					"minLength": 1
				},
				"pageIds": {
					"type": "array",
					"items": {
						"type": "string",
						"format": "uuid"
					}
				},
				"submits": {
					"$ref": "#/$defs/DATA_EVY_FlowSubmits"
				},
				"visibility": {
					"$ref": "#/$defs/Visibility"
				},
				"createdAt": {
					"type": "string",
					"format": "date-time"
				},
				"updatedAt": {
					"type": "string",
					"format": "date-time"
				},
				"deletedAt": {
					"description": "Set when the record is deleted. Tombstoned rows are excluded from plain reads but included in incremental ones, so clients learn about deletions.",
					"type": "string",
					"format": "date-time"
				}
			}
		},
		"DATA_EVY_FlowSubmits": {
			"description": "Domain entity a flow submits via create(...,submit). Declared so clients validate rather than infer submission semantics from action strings.",
			"type": "object",
			"additionalProperties": false,
			"required": ["service", "resource"],
			"properties": {
				"service": {
					"type": "string",
					"format": "uuid"
				},
				"resource": {
					"type": "string",
					"minLength": 1
				}
			}
		},
		"OS": {
			"type": "string",
			"enum": ["ios", "android", "Web"]
		},
		"DATA_EVY_Device": {
			"type": "object",
			"additionalProperties": false,
			"required": ["token", "os", "createdAt", "visibility"],
			"properties": {
				"token": {
					"type": "string",
					"maxLength": 256
				},
				"os": {
					"$ref": "#/$defs/OS"
				},
				"visibility": {
					"$ref": "#/$defs/Visibility"
				},
				"createdAt": {
					"type": "string",
					"format": "date-time"
				}
			}
		},
		"DATA_EVY_Service": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"name",
				"description",
				"createdAt",
				"updatedAt",
				"visibility"
			],
			"properties": {
				"id": {
					"type": "string",
					"format": "uuid"
				},
				"name": {
					"type": "string",
					"maxLength": 50
				},
				"description": {
					"type": "string"
				},
				"wsHost": {
					"description": "WebSocket host the API dials for this service. Falls back to the <NAME>_WS_HOST env var when unset.",
					"type": "string",
					"maxLength": 253
				},
				"wsPort": {
					"description": "WebSocket port paired with wsHost. Falls back to <NAME>_WS_PORT when unset.",
					"type": "integer",
					"minimum": 1,
					"maximum": 65535
				},
				"sortOrder": {
					"type": "integer"
				},
				"visibility": {
					"$ref": "#/$defs/Visibility"
				},
				"createdAt": {
					"type": "string",
					"format": "date-time"
				},
				"updatedAt": {
					"type": "string",
					"format": "date-time"
				},
				"deletedAt": {
					"description": "Set when the record is deleted. Tombstoned rows are excluded from plain reads but included in incremental ones, so clients learn about deletions.",
					"type": "string",
					"format": "date-time"
				}
			}
		},
		"DATA_EVY_Organization": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"name",
				"description",
				"logo",
				"url",
				"supportEmail",
				"createdAt",
				"updatedAt",
				"visibility"
			],
			"properties": {
				"id": {
					"type": "string",
					"format": "uuid"
				},
				"name": {
					"type": "string",
					"maxLength": 100
				},
				"description": {
					"type": "string"
				},
				"logo": {
					"type": "string",
					"format": "uuid"
				},
				"url": {
					"type": "string",
					"maxLength": 50
				},
				"supportEmail": {
					"type": "string",
					"maxLength": 50
				},
				"visibility": {
					"$ref": "#/$defs/Visibility"
				},
				"createdAt": {
					"type": "string",
					"format": "date-time"
				},
				"updatedAt": {
					"type": "string",
					"format": "date-time"
				},
				"deletedAt": {
					"description": "Set when the record is deleted. Tombstoned rows are excluded from plain reads but included in incremental ones, so clients learn about deletions.",
					"type": "string",
					"format": "date-time"
				}
			}
		},
		"DATA_EVY_ServiceProvider": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"fkServiceId",
				"fkOrganizationId",
				"name",
				"description",
				"logo",
				"url",
				"createdAt",
				"updatedAt",
				"retired",
				"visibility"
			],
			"properties": {
				"id": {
					"type": "string",
					"format": "uuid"
				},
				"fkServiceId": {
					"type": "string",
					"format": "uuid"
				},
				"fkOrganizationId": {
					"type": "string",
					"format": "uuid"
				},
				"name": {
					"type": "string",
					"maxLength": 100
				},
				"description": {
					"type": "string"
				},
				"logo": {
					"type": "string",
					"format": "uuid"
				},
				"url": {
					"type": "string",
					"maxLength": 50
				},
				"visibility": {
					"$ref": "#/$defs/Visibility"
				},
				"createdAt": {
					"type": "string",
					"format": "date-time"
				},
				"updatedAt": {
					"type": "string",
					"format": "date-time"
				},
				"deletedAt": {
					"description": "Set when the record is deleted. Tombstoned rows are excluded from plain reads but included in incremental ones, so clients learn about deletions.",
					"type": "string",
					"format": "date-time"
				},
				"retired": {
					"type": "boolean",
					"default": false
				}
			}
		},
		"DATA_EVY_File": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "type", "createdAt", "updatedAt", "visibility"],
			"properties": {
				"id": {
					"type": "string",
					"format": "uuid"
				},
				"type": {
					"type": "string",
					"minLength": 1
				},
				"visibility": {
					"$ref": "#/$defs/Visibility"
				},
				"createdAt": {
					"type": "string",
					"format": "date-time"
				},
				"updatedAt": {
					"type": "string",
					"format": "date-time"
				},
				"deletedAt": {
					"description": "Set when the record is deleted. Tombstoned rows are excluded from plain reads but included in incremental ones, so clients learn about deletions.",
					"type": "string",
					"format": "date-time"
				}
			}
		},
		"DATA_EVY_Page": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"name",
				"rowIds",
				"createdAt",
				"updatedAt",
				"visibility"
			],
			"properties": {
				"id": {
					"type": "string",
					"format": "uuid"
				},
				"name": {
					"type": "string",
					"minLength": 1
				},
				"title": {
					"type": "string"
				},
				"rowIds": {
					"type": "array",
					"items": {
						"type": "string",
						"format": "uuid"
					}
				},
				"footerRowId": {
					"type": "string",
					"format": "uuid"
				},
				"visibility": {
					"$ref": "#/$defs/Visibility"
				},
				"createdAt": {
					"type": "string",
					"format": "date-time"
				},
				"updatedAt": {
					"type": "string",
					"format": "date-time"
				},
				"deletedAt": {
					"description": "Set when the record is deleted. Tombstoned rows are excluded from plain reads but included in incremental ones, so clients learn about deletions.",
					"type": "string",
					"format": "date-time"
				}
			}
		},
		"DATA_EVY_RowData": {
			"description": "Row payload. Unknown keys are unconstrained JSON. `additionalProperties: true` rather than a JSONValue $ref: the ref renders as a closed TypeScript index signature that conflicts with the typed properties below (a property may be undefined, which the JSONValue union excludes), while `true` renders `[k: string]: unknown`. Both accept exactly the same wire input.",
			"type": "object",
			"additionalProperties": true,
			"properties": {
				"actions": {
					"description": "Trigger-keyed action lists. Optional for storage, but validated when present so a malformed shape is rejected at write time instead of silently dropping the row on the client.",
					"$ref": "../sdui/evy.schema.json#/$defs/UI_RowActions"
				},
				"sheet_row_id": {
					"type": "string",
					"format": "uuid"
				},
				"child_row_id": {
					"type": "string",
					"format": "uuid",
					"description": "Search-only result template relationship at the SDUI layer."
				},
				"children_row_ids": {
					"type": "array",
					"items": {
						"type": "string",
						"format": "uuid"
					}
				}
			}
		},
		"DATA_EVY_Row": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"name",
				"type",
				"visible",
				"data",
				"createdAt",
				"updatedAt",
				"visibility"
			],
			"properties": {
				"id": {
					"type": "string",
					"format": "uuid"
				},
				"name": {
					"type": "string",
					"minLength": 1
				},
				"type": {
					"type": "string",
					"enum": [
						"Button",
						"Calendar",
						"HorizontalContainer",
						"Dropdown",
						"Heading",
						"Text",
						"TextAction",
						"TextExpand",
						"InlinePicker",
						"Map",
						"InputList",
						"Input",
						"VerticalContainer",
						"ListItem",
						"Search",
						"PhotoGallery",
						"SelectPhoto",
						"TabContainer",
						"TextArea",
						"TextSelect",
						"TimeslotPicker"
					]
				},
				"visible": {
					"type": "string"
				},
				"data": {
					"$ref": "#/$defs/DATA_EVY_RowData"
				},
				"visibility": {
					"$ref": "#/$defs/Visibility"
				},
				"createdAt": {
					"type": "string",
					"format": "date-time"
				},
				"updatedAt": {
					"type": "string",
					"format": "date-time"
				},
				"deletedAt": {
					"description": "Set when the record is deleted. Tombstoned rows are excluded from plain reads but included in incremental ones, so clients learn about deletions.",
					"type": "string",
					"format": "date-time"
				}
			}
		}
	}
}
