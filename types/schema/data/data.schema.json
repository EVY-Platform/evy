{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "data",
	"title": "DATA_EVY_Rows",
	"description": "API persistence row types: DATA_EVY_Flow, DATA_EVY_Device, DATA_EVY_Service, etc. Date-time fields use ISO 8601 / RFC 3339 strings (format date-time), not Unix timestamps; Drizzle maps them to Postgres text columns.",
	"oneOf": [
		{
			"$ref": "#/$defs/DATA_EVY_Flow"
		},
		{
			"$ref": "#/$defs/DATA_EVY_Page"
		},
		{
			"$ref": "#/$defs/DATA_EVY_Row"
		},
		{
			"$ref": "#/$defs/DATA_EVY_Device"
		},
		{
			"$ref": "#/$defs/DATA_EVY_Service"
		},
		{
			"$ref": "#/$defs/DATA_EVY_Organization"
		},
		{
			"$ref": "#/$defs/DATA_EVY_ServiceProvider"
		},
		{
			"$ref": "#/$defs/DATA_EVY_ServiceResource"
		},
		{
			"$ref": "#/$defs/DATA_EVY_File"
		}
	],
	"$defs": {
		"DATA_EVY_Flow": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "name", "pageIds", "createdAt", "updatedAt"],
			"properties": {
				"id": {
					"type": "string",
					"format": "uuid"
				},
				"name": {
					"type": "string",
					"minLength": 1
				},
				"pageIds": {
					"type": "array",
					"items": {
						"type": "string",
						"format": "uuid"
					}
				},
				"createdAt": {
					"type": "string",
					"format": "date-time"
				},
				"updatedAt": {
					"type": "string",
					"format": "date-time"
				}
			}
		},
		"OS": {
			"type": "string",
			"enum": ["ios", "android", "Web"]
		},
		"DATA_EVY_Device": {
			"type": "object",
			"additionalProperties": false,
			"required": ["token", "os", "createdAt"],
			"properties": {
				"token": {
					"type": "string",
					"maxLength": 256
				},
				"os": {
					"$ref": "#/$defs/OS"
				},
				"createdAt": {
					"type": "string",
					"format": "date-time"
				}
			}
		},
		"DATA_EVY_Service": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "name", "description", "createdAt", "updatedAt"],
			"properties": {
				"id": {
					"type": "string",
					"format": "uuid"
				},
				"name": {
					"type": "string",
					"maxLength": 50
				},
				"description": {
					"type": "string"
				},
				"sortOrder": {
					"type": "integer"
				},
				"createdAt": {
					"type": "string",
					"format": "date-time"
				},
				"updatedAt": {
					"type": "string",
					"format": "date-time"
				}
			}
		},
		"DATA_EVY_Organization": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"name",
				"description",
				"logo",
				"url",
				"supportEmail",
				"createdAt",
				"updatedAt"
			],
			"properties": {
				"id": {
					"type": "string",
					"format": "uuid"
				},
				"name": {
					"type": "string",
					"maxLength": 100
				},
				"description": {
					"type": "string"
				},
				"logo": {
					"type": "string",
					"format": "uuid"
				},
				"url": {
					"type": "string",
					"maxLength": 50
				},
				"supportEmail": {
					"type": "string",
					"maxLength": 50
				},
				"createdAt": {
					"type": "string",
					"format": "date-time"
				},
				"updatedAt": {
					"type": "string",
					"format": "date-time"
				}
			}
		},
		"DATA_EVY_ServiceProvider": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"fkServiceId",
				"fkOrganizationId",
				"name",
				"description",
				"logo",
				"url",
				"createdAt",
				"updatedAt",
				"retired"
			],
			"properties": {
				"id": {
					"type": "string",
					"format": "uuid"
				},
				"fkServiceId": {
					"type": "string",
					"format": "uuid"
				},
				"fkOrganizationId": {
					"type": "string",
					"format": "uuid"
				},
				"name": {
					"type": "string",
					"maxLength": 100
				},
				"description": {
					"type": "string"
				},
				"logo": {
					"type": "string",
					"format": "uuid"
				},
				"url": {
					"type": "string",
					"maxLength": 50
				},
				"createdAt": {
					"type": "string",
					"format": "date-time"
				},
				"updatedAt": {
					"type": "string",
					"format": "date-time"
				},
				"retired": {
					"type": "boolean",
					"default": false
				}
			}
		},
		"DATA_EVY_ServiceResource": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "fkServiceId", "name", "createdAt", "updatedAt"],
			"properties": {
				"id": {
					"type": "string",
					"format": "uuid"
				},
				"fkServiceId": {
					"type": "string",
					"format": "uuid"
				},
				"name": {
					"type": "string",
					"maxLength": 50
				},
				"createdAt": {
					"type": "string",
					"format": "date-time"
				},
				"updatedAt": {
					"type": "string",
					"format": "date-time"
				}
			}
		},
		"DATA_EVY_File": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "type", "createdAt", "updatedAt"],
			"properties": {
				"id": {
					"type": "string",
					"format": "uuid"
				},
				"type": {
					"type": "string",
					"minLength": 1
				},
				"createdAt": {
					"type": "string",
					"format": "date-time"
				},
				"updatedAt": {
					"type": "string",
					"format": "date-time"
				}
			}
		},
		"DATA_EVY_Page": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "name", "rowIds", "createdAt", "updatedAt"],
			"properties": {
				"id": {
					"type": "string",
					"format": "uuid"
				},
				"name": {
					"type": "string",
					"minLength": 1
				},
				"title": {
					"type": "string"
				},
				"rowIds": {
					"type": "array",
					"items": {
						"type": "string",
						"format": "uuid"
					}
				},
				"footerRowId": {
					"type": "string",
					"format": "uuid"
				},
				"createdAt": {
					"type": "string",
					"format": "date-time"
				},
				"updatedAt": {
					"type": "string",
					"format": "date-time"
				}
			}
		},
		"DATA_EVY_RowData": {
			"type": "object",
			"additionalProperties": {
				"$ref": "../common/json.schema.json#/$defs/JSONValue"
			},
			"properties": {
				"sheet_row_id": {
					"type": "string",
					"format": "uuid"
				},
				"child_row_id": {
					"type": "string",
					"format": "uuid",
					"description": "Search-only result template relationship at the SDUI layer."
				},
				"children_row_ids": {
					"type": "array",
					"items": {
						"type": "string",
						"format": "uuid"
					}
				}
			}
		},
		"DATA_EVY_Row": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"name",
				"type",
				"visible",
				"data",
				"createdAt",
				"updatedAt"
			],
			"properties": {
				"id": {
					"type": "string",
					"format": "uuid"
				},
				"name": {
					"type": "string",
					"minLength": 1
				},
				"type": {
					"type": "string",
					"enum": [
						"Button",
						"Calendar",
						"HorizontalContainer",
						"Dropdown",
						"Heading",
						"Text",
						"TextAction",
						"TextExpand",
						"InlinePicker",
						"Map",
						"InputList",
						"Input",
						"VerticalContainer",
						"ListItem",
						"Search",
						"PhotoGallery",
						"SelectPhoto",
						"TabContainer",
						"TextArea",
						"TextSelect",
						"TimeslotPicker"
					]
				},
				"visible": {
					"type": "string"
				},
				"data": {
					"$ref": "#/$defs/DATA_EVY_RowData"
				},
				"createdAt": {
					"type": "string",
					"format": "date-time"
				},
				"updatedAt": {
					"type": "string",
					"format": "date-time"
				}
			}
		}
	}
}
