{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "delete-request",
	"title": "DeleteRequest",
	"description": "JSON-RPC params for delete method. Service, resource, and filter.id are required.",
	"type": "object",
	"additionalProperties": false,
	"required": ["service", "resource", "filter"],
	"properties": {
		"service": {
			"type": "string",
			"minLength": 1
		},
		"resource": {
			"type": "string",
			"minLength": 1,
			"maxLength": 50
		},
		"filter": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id"],
			"properties": {
				"id": {
					"type": "string",
					"minLength": 1
				}
			}
		}
	}
}
