{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "complete-image-upload-request",
	"title": "CompleteImageUploadRequest",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"uploadId",
		"type",
		"totalBytes"
	],
	"properties": {
		"uploadId": {
			"type": "string",
			"format": "uuid"
		},
		"type": {
			"type": "string",
			"enum": [
				"image/jpeg",
				"image/png"
			]
		},
		"totalBytes": {
			"type": "integer",
			"minimum": 1
		}
	}
}
