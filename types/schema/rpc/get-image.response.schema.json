{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "get-image-response",
	"title": "GetImageResponse",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"id",
		"type",
		"createdAt",
		"dataBase64"
	],
	"properties": {
		"id": {
			"type": "string",
			"format": "uuid"
		},
		"type": {
			"type": "string",
			"enum": [
				"image/jpeg",
				"image/png"
			]
		},
		"createdAt": {
			"type": "string",
			"format": "date-time"
		},
		"dataBase64": {
			"type": "string"
		}
	}
}
