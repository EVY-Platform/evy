{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "get-request",
	"title": "GetRequest",
	"description": "JSON-RPC params for get method. Resource is validated at runtime against the service registry.",
	"type": "object",
	"additionalProperties": false,
	"required": ["resource"],
	"properties": {
		"resource": {
			"$ref": "../common/rpc.schema.json#/$defs/ResourceRef"
		},
		"filter": {
			"$ref": "../common/rpc.schema.json#/$defs/DataFilter"
		}
	}
}
