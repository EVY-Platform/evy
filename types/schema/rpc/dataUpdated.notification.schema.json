{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "dataUpdated-notification",
	"title": "DataUpdatedNotification",
	"description": "JSON-RPC notification payload for dataUpdated event. Matches an individual sync data row.",
	"type": "object",
	"additionalProperties": false,
	"required": ["service", "resource", "value"],
	"properties": {
		"service": {
			"type": "string"
		},
		"resource": {
			"type": "string"
		},
		"value": {
			"$ref": "../common/json.schema.json#/$defs/JSONValue"
		}
	}
}
