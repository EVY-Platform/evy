{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "create-request",
	"title": "CreateRequest",
	"description": "JSON-RPC params for create method. Service and resource are validated at runtime against the service registry.",
	"$defs": {
		"CreateDataPayload": {
			"type": "object",
			"additionalProperties": {
				"$ref": "../common/json.schema.json#/$defs/JSONValue"
			}
		}
	},
	"type": "object",
	"additionalProperties": false,
	"required": [
		"service",
		"resource",
		"data"
	],
	"properties": {
		"service": {
			"type": "string",
			"minLength": 1
		},
		"resource": {
			"type": "string",
			"minLength": 1,
			"maxLength": 50
		},
		"filter": {
			"$ref": "../common/rpc.schema.json#/$defs/DataFilter"
		},
		"data": {
			"$ref": "#/$defs/CreateDataPayload"
		}
	}
}
