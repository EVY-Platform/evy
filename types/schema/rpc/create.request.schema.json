{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "create-request",
	"title": "CreateRequest",
	"description": "JSON-RPC params for create method. Resource is validated at runtime against the service registry.",
	"$defs": {
		"CreateDataPayload": {
			"type": "object",
			"additionalProperties": {
				"$ref": "../common/json.schema.json#/$defs/JSONValue"
			}
		}
	},
	"type": "object",
	"additionalProperties": false,
	"required": ["resource", "data"],
	"properties": {
		"resource": {
			"$ref": "../common/rpc.schema.json#/$defs/ResourceRef"
		},
		"filter": {
			"$ref": "../common/rpc.schema.json#/$defs/DataFilter"
		},
		"data": {
			"$ref": "#/$defs/CreateDataPayload"
		}
	}
}
