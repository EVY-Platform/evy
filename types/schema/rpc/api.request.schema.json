{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "api_request",
	"title": "ApiRequest",
	"description": "JSON-RPC params for custom API-backed client functions. Routes a service/method request through the API gateway to evy core or the owning backend service.",
	"$defs": {
		"ApiDataPayload": {
			"type": "object",
			"additionalProperties": {
				"$ref": "../common/json.schema.json#/$defs/JSONValue"
			}
		}
	},
	"type": "object",
	"additionalProperties": false,
	"required": ["service", "method"],
	"properties": {
		"service": {
			"$ref": "../common/rpc.schema.json#/$defs/ServiceSlug"
		},
		"resource": {
			"type": "string",
			"minLength": 1,
			"maxLength": 50
		},
		"method": {
			"type": "string",
			"minLength": 1
		},
		"filter": {
			"$ref": "../common/rpc.schema.json#/$defs/DataFilter"
		},
		"data": {
			"$ref": "#/$defs/ApiDataPayload"
		}
	}
}
