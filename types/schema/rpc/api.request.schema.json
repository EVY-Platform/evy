{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "api-request",
	"title": "ApiRequest",
	"description": "JSON-RPC params for API-backed client functions. Routes a service/resource/method request through the API gateway to the owning backend service.",
	"type": "object",
	"additionalProperties": false,
	"required": ["service", "resource", "method"],
	"properties": {
		"service": {
			"type": "string",
			"minLength": 1
		},
		"resource": {
			"type": "string",
			"minLength": 1,
			"maxLength": 50
		},
		"method": {
			"type": "string",
			"minLength": 1
		},
		"filter": {
			"$ref": "../common/rpc.schema.json#/$defs/DataFilter"
		}
	}
}
