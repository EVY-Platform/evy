{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "data_changed-notification",
	"title": "DataChangedNotification",
	"description": "JSON-RPC notification payload for dataChanged event. Matches an individual sync data row with create/update operation.",
	"type": "object",
	"additionalProperties": false,
	"required": ["resource", "operation", "value"],
	"properties": {
		"resource": {
			"$ref": "../common/rpc.schema.json#/$defs/ResourceRef"
		},
		"operation": {
			"type": "string",
			"enum": ["create", "update", "delete"]
		},
		"value": {
			"$ref": "../common/json.schema.json#/$defs/JSONValue"
		}
	}
}
