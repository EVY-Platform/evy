{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "update-request",
	"title": "UpdateRequest",
	"description": "JSON-RPC params for update method. Service, resource, filter.id, and data are required.",
	"$defs": {
		"UpdateDataPayload": {
			"type": "object",
			"additionalProperties": {
				"$ref": "../common/json.schema.json#/$defs/JSONValue"
			}
		}
	},
	"type": "object",
	"additionalProperties": false,
	"required": ["service", "resource", "filter", "data"],
	"properties": {
		"service": {
			"type": "string",
			"minLength": 1
		},
		"resource": {
			"type": "string",
			"minLength": 1,
			"maxLength": 50
		},
		"filter": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id"],
			"properties": {
				"id": {
					"type": "string",
					"minLength": 1
				},
				"updatedAfter": {
					"type": "string",
					"format": "date-time"
				}
			}
		},
		"data": {
			"$ref": "#/$defs/UpdateDataPayload"
		}
	}
}
