{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "sync-response",
	"title": "SyncResponse",
	"description": "JSON-RPC response for the unified sync method. Returns all changed rows across all services since lastSyncTime.",
	"type": "object",
	"additionalProperties": false,
	"required": ["data", "cursor"],
	"properties": {
		"cursor": {
			"description": "Pass to the next sync call. Opaque: clients must not parse or generate it.",
			"type": "string"
		},
		"data": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["service", "resource", "value"],
				"properties": {
					"service": {
						"type": "string"
					},
					"resource": {
						"type": "string"
					},
					"value": {
						"$ref": "../common/json.schema.json#/$defs/JSONValue"
					}
				}
			}
		}
	}
}
