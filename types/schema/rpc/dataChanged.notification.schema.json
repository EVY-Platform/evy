{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "dataChanged-notification",
	"title": "DataChangedNotification",
	"description": "JSON-RPC notification payload for dataChanged event. Matches an individual sync data row with create/update operation.",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"service",
		"resource",
		"operation",
		"value"
	],
	"properties": {
		"service": {
			"type": "string"
		},
		"resource": {
			"type": "string"
		},
		"operation": {
			"type": "string",
			"enum": [
				"create",
				"update"
			]
		},
		"value": {
			"$ref": "../common/json.schema.json#/$defs/JSONValue"
		}
	}
}
