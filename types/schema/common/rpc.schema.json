{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "common/rpc",
	"title": "CommonRPC",
	"description": "Shared RPC request/response definitions",
	"$defs": {
		"ServiceSlug": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9_-]*$",
			"maxLength": 50
		},
		"ResourceRef": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9_-]*\\.[a-z][a-z0-9_-]*$",
			"maxLength": 100
		},
		"DataFilter": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"id": {
					"type": "string",
					"format": "uuid"
				},
				"updated_after": {
					"type": "string",
					"format": "date-time"
				}
			}
		},
		"IdFilter": {
			"$ref": "#/$defs/DataFilter"
		}
	}
}
