{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "common/rpc",
	"title": "CommonRPC",
	"description": "Shared RPC request/response definitions",
	"$defs": {
		"DataFilter": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"ids": {
					"type": "array",
					"items": {
						"type": "string",
						"format": "uuid"
					}
				},
				"updatedAfter": {
					"type": "string",
					"format": "date-time"
				},
				"queryText": {
					"type": "string"
				},
				"tagIds": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"limit": {
					"type": "integer",
					"minimum": 1
				},
				"offset": {
					"type": "integer",
					"minimum": 0
				}
			}
		},
		"IdFilter": {
			"$ref": "#/$defs/DataFilter"
		}
	}
}
