{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "address",
	"title": "Address",
	"description": "Canonical EVY structured address.",
	"type": "object",
	"additionalProperties": false,
	"required": ["street", "city", "country", "latitude", "longitude"],
	"properties": {
		"unit": {
			"type": "string"
		},
		"street": {
			"type": "string"
		},
		"city": {
			"type": "string"
		},
		"postcode": {
			"type": "string"
		},
		"state": {
			"type": "string"
		},
		"country": {
			"type": "string"
		},
		"latitude": {
			"type": "number"
		},
		"longitude": {
			"type": "number"
		}
	},
	"$defs": {
		"Address": {
			"$ref": "#"
		}
	}
}
