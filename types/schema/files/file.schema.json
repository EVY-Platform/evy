{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "files/file",
	"title": "FileResource",
	"description": "Shared EVY file resource shapes for metadata, binary responses, upload chunks, and file-specific RPC params.",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"file_metadata",
		"file_with_binary",
		"file_upload_chunk_metadata",
		"create_file_params",
		"get_files_params",
		"delete_file_params",
		"cancel_upload_params",
		"cancel_upload_response"
	],
	"properties": {
		"file_metadata": {
			"$ref": "#/$defs/FileMetadata"
		},
		"file_with_binary": {
			"$ref": "#/$defs/FileWithBinary"
		},
		"file_upload_chunk_metadata": {
			"$ref": "#/$defs/FileUploadChunkMetadata"
		},
		"create_file_params": {
			"$ref": "#/$defs/CreateFileParams"
		},
		"get_files_params": {
			"$ref": "#/$defs/GetFilesParams"
		},
		"delete_file_params": {
			"$ref": "#/$defs/DeleteFileParams"
		},
		"cancel_upload_params": {
			"$ref": "#/$defs/CancelUploadParams"
		},
		"cancel_upload_response": {
			"$ref": "#/$defs/CancelUploadResponse"
		}
	},
	"$defs": {
		"FileMetadata": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"type",
				"created_at",
				"updated_at",
				"visibility"
			],
			"properties": {
				"id": {
					"type": "string",
					"format": "uuid"
				},
				"type": {
					"type": "string",
					"minLength": 1
				},
				"visibility": {
					"description": "Matches DATA_EVY_File.visibility - the same record, so the same required field. Stated on create like every other resource; nothing defaults it.",
					"type": "string",
					"enum": ["public", "private"]
				},
				"created_at": {
					"type": "string",
					"format": "date-time"
				},
				"updated_at": {
					"type": "string",
					"format": "date-time"
				}
			}
		},
		"FileWithBinary": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"type",
				"created_at",
				"updated_at",
				"data_base64",
				"visibility"
			],
			"properties": {
				"id": {
					"type": "string",
					"format": "uuid"
				},
				"type": {
					"type": "string",
					"minLength": 1
				},
				"visibility": {
					"description": "Matches DATA_EVY_File.visibility - the same record, so the same required field. Stated on create like every other resource; nothing defaults it.",
					"type": "string",
					"enum": ["public", "private"]
				},
				"created_at": {
					"type": "string",
					"format": "date-time"
				},
				"updated_at": {
					"type": "string",
					"format": "date-time"
				},
				"data_base64": {
					"type": "string"
				}
			}
		},
		"FileUploadChunkMetadata": {
			"type": "object",
			"additionalProperties": false,
			"required": ["upload_id", "index", "byte_offset", "byte_length"],
			"properties": {
				"upload_id": {
					"type": "string",
					"format": "uuid"
				},
				"index": {
					"type": "integer",
					"minimum": 0
				},
				"byte_offset": {
					"type": "integer",
					"minimum": 0
				},
				"byte_length": {
					"type": "integer",
					"minimum": 1
				}
			}
		},
		"FileIdFilter": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id"],
			"properties": {
				"id": {
					"type": "string",
					"format": "uuid"
				}
			}
		},
		"FileGetFilter": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"id": {
					"type": "string",
					"format": "uuid"
				},
				"updated_after": {
					"type": "string",
					"format": "date-time"
				}
			}
		},
		"CreateFileParams": {
			"type": "object",
			"additionalProperties": false,
			"required": ["service", "resource", "filter", "data"],
			"properties": {
				"service": {
					"type": "string",
					"minLength": 1
				},
				"resource": {
					"type": "string",
					"enum": ["files"]
				},
				"filter": {
					"$ref": "#/$defs/FileIdFilter"
				},
				"data": {
					"$ref": "#/$defs/FileMetadata"
				}
			}
		},
		"GetFilesParams": {
			"type": "object",
			"additionalProperties": false,
			"required": ["service", "resource", "filter"],
			"properties": {
				"service": {
					"type": "string",
					"minLength": 1
				},
				"resource": {
					"type": "string",
					"enum": ["files"]
				},
				"filter": {
					"$ref": "#/$defs/FileGetFilter"
				}
			}
		},
		"DeleteFileParams": {
			"type": "object",
			"additionalProperties": false,
			"required": ["service", "resource", "filter"],
			"properties": {
				"service": {
					"type": "string",
					"minLength": 1
				},
				"resource": {
					"type": "string",
					"enum": ["files"]
				},
				"filter": {
					"$ref": "#/$defs/FileIdFilter"
				}
			}
		},
		"CancelUploadParams": {
			"type": "object",
			"additionalProperties": false,
			"required": ["upload_id"],
			"properties": {
				"upload_id": {
					"type": "string"
				}
			}
		},
		"CancelUploadResponse": {
			"type": "object",
			"additionalProperties": false,
			"required": ["ok"],
			"properties": {
				"ok": {
					"type": "boolean"
				}
			}
		}
	}
}
