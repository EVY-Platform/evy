{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "files/file",
	"title": "FileResource",
	"description": "Shared EVY file resource shapes for metadata, binary responses, upload chunks, and file-specific RPC params.",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"fileMetadata",
		"fileWithBinary",
		"fileUploadChunkMetadata",
		"createFileParams",
		"getFilesParams",
		"deleteFileParams",
		"cancelUploadParams",
		"cancelUploadResponse"
	],
	"properties": {
		"fileMetadata": {
			"$ref": "#/$defs/FileMetadata"
		},
		"fileWithBinary": {
			"$ref": "#/$defs/FileWithBinary"
		},
		"fileUploadChunkMetadata": {
			"$ref": "#/$defs/FileUploadChunkMetadata"
		},
		"createFileParams": {
			"$ref": "#/$defs/CreateFileParams"
		},
		"getFilesParams": {
			"$ref": "#/$defs/GetFilesParams"
		},
		"deleteFileParams": {
			"$ref": "#/$defs/DeleteFileParams"
		},
		"cancelUploadParams": {
			"$ref": "#/$defs/CancelUploadParams"
		},
		"cancelUploadResponse": {
			"$ref": "#/$defs/CancelUploadResponse"
		}
	},
	"$defs": {
		"FileMetadata": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "type", "createdAt", "updatedAt", "visibility"],
			"properties": {
				"id": {
					"type": "string",
					"format": "uuid"
				},
				"type": {
					"type": "string",
					"minLength": 1
				},
				"visibility": {
					"description": "Matches DATA_EVY_File.visibility - the same record, so the same required field. Stated on create like every other resource; nothing defaults it.",
					"type": "string",
					"enum": ["public", "private"]
				},
				"createdAt": {
					"type": "string",
					"format": "date-time"
				},
				"updatedAt": {
					"type": "string",
					"format": "date-time"
				}
			}
		},
		"FileWithBinary": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"type",
				"createdAt",
				"updatedAt",
				"dataBase64",
				"visibility"
			],
			"properties": {
				"id": {
					"type": "string",
					"format": "uuid"
				},
				"type": {
					"type": "string",
					"minLength": 1
				},
				"visibility": {
					"description": "Matches DATA_EVY_File.visibility - the same record, so the same required field. Stated on create like every other resource; nothing defaults it.",
					"type": "string",
					"enum": ["public", "private"]
				},
				"createdAt": {
					"type": "string",
					"format": "date-time"
				},
				"updatedAt": {
					"type": "string",
					"format": "date-time"
				},
				"dataBase64": {
					"type": "string"
				}
			}
		},
		"FileUploadChunkMetadata": {
			"type": "object",
			"additionalProperties": false,
			"required": ["uploadId", "index", "byteOffset", "byteLength"],
			"properties": {
				"uploadId": {
					"type": "string",
					"format": "uuid"
				},
				"index": {
					"type": "integer",
					"minimum": 0
				},
				"byteOffset": {
					"type": "integer",
					"minimum": 0
				},
				"byteLength": {
					"type": "integer",
					"minimum": 1
				}
			}
		},
		"FileIdFilter": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id"],
			"properties": {
				"id": {
					"type": "string",
					"format": "uuid"
				}
			}
		},
		"FileGetFilter": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"id": {
					"type": "string",
					"format": "uuid"
				},
				"updatedAfter": {
					"type": "string",
					"format": "date-time"
				}
			}
		},
		"CreateFileParams": {
			"type": "object",
			"additionalProperties": false,
			"required": ["service", "resource", "filter", "data"],
			"properties": {
				"service": {
					"type": "string",
					"minLength": 1
				},
				"resource": {
					"type": "string",
					"enum": ["files"]
				},
				"filter": {
					"$ref": "#/$defs/FileIdFilter"
				},
				"data": {
					"$ref": "#/$defs/FileMetadata"
				}
			}
		},
		"GetFilesParams": {
			"type": "object",
			"additionalProperties": false,
			"required": ["service", "resource", "filter"],
			"properties": {
				"service": {
					"type": "string",
					"minLength": 1
				},
				"resource": {
					"type": "string",
					"enum": ["files"]
				},
				"filter": {
					"$ref": "#/$defs/FileGetFilter"
				}
			}
		},
		"DeleteFileParams": {
			"type": "object",
			"additionalProperties": false,
			"required": ["service", "resource", "filter"],
			"properties": {
				"service": {
					"type": "string",
					"minLength": 1
				},
				"resource": {
					"type": "string",
					"enum": ["files"]
				},
				"filter": {
					"$ref": "#/$defs/FileIdFilter"
				}
			}
		},
		"CancelUploadParams": {
			"type": "object",
			"additionalProperties": false,
			"required": ["uploadId"],
			"properties": {
				"uploadId": {
					"type": "string"
				}
			}
		},
		"CancelUploadResponse": {
			"type": "object",
			"additionalProperties": false,
			"required": ["ok"],
			"properties": {
				"ok": {
					"type": "boolean"
				}
			}
		}
	}
}
