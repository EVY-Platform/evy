{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "sdui/definitions/button",
	"title": "Button_Row",
	"triggers": {
		"tap": "required"
	},
	"allOf": [
		{
			"$ref": "../evy.schema.json#/$defs/UI_RowBase"
		},
		{
			"type": "object",
			"required": ["type", "label"],
			"properties": {
				"type": {
					"const": "button"
				},
				"title": {
					"type": "string"
				},
				"label": {
					"type": "string"
				},
				"style": {
					"type": "string",
					"enum": ["primary", "danger"]
				}
			}
		}
	],
	"unevaluatedProperties": false
}
