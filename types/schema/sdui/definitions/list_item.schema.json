{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "sdui/definitions/list_item",
	"title": "ListItem_Row",
	"triggers": {
		"tap": "optional",
		"swipe_left": "optional"
	},
	"allOf": [
		{
			"$ref": "../evy.schema.json#/$defs/UI_RowBase"
		},
		{
			"type": "object",
			"required": ["type"],
			"properties": {
				"type": {
					"const": "list_item"
				},
				"title": {
					"type": "string"
				},
				"subtitle": {
					"type": "string"
				},
				"image": {
					"type": "string"
				},
				"swipe_label": {
					"type": "string"
				}
			}
		}
	],
	"unevaluatedProperties": false
}
