{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "sdui/definitions/tab_container",
	"title": "TabContainer_Row",
	"triggers": {
		"tap": "optional"
	},
	"allOf": [
		{
			"$ref": "../evy.schema.json#/$defs/UI_RowBase"
		},
		{
			"type": "object",
			"required": ["type", "children", "segments"],
			"properties": {
				"type": {
					"const": "tab_container"
				},
				"title": {
					"type": "string"
				},
				"children": {
					"type": "array",
					"items": {
						"$ref": "../evy.schema.json#/$defs/UI_Row"
					}
				},
				"segments": {
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			}
		}
	],
	"unevaluatedProperties": false
}
