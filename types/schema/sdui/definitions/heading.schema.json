{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "sdui/definitions/heading",
	"title": "Heading_Row",
	"triggers": {
		"tap": "optional",
		"swipe_left": "optional"
	},
	"allOf": [
		{
			"$ref": "../evy.schema.json#/$defs/UI_RowBase"
		},
		{
			"type": "object",
			"required": ["type", "title"],
			"properties": {
				"type": {
					"const": "heading"
				},
				"title": {
					"type": "string"
				},
				"label": {
					"type": "string"
				},
				"swipe_label": {
					"type": "string"
				},
				"swipe_color": {
					"type": "string",
					"pattern": "^$|^#[0-9A-Fa-f]{6}$"
				}
			}
		}
	],
	"unevaluatedProperties": false
}
