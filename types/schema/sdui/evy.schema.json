{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "sdui",
	"title": "UI_Flow",
	"description": "UI types: UI_Flow, UI_Page, UI_Row",
	"type": "object",
	"additionalProperties": false,
	"required": ["id", "name", "pages"],
	"properties": {
		"id": {
			"type": "string",
			"format": "uuid"
		},
		"name": {
			"type": "string",
			"minLength": 1
		},
		"pages": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/UI_Page"
			}
		}
	},
	"$defs": {
		"UI_Page": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "title", "rows"],
			"properties": {
				"id": {
					"type": "string",
					"format": "uuid"
				},
				"title": {
					"type": "string"
				},
				"rows": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/UI_Row"
					}
				},
				"footer": {
					"$ref": "#/$defs/UI_Row"
				},
				"name": {
					"type": "string"
				}
			}
		},
		"UI_Row": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "type", "source", "actions", "visible", "title"],
			"properties": {
				"id": {
					"type": "string",
					"format": "uuid"
				},
				"type": {
					"type": "string",
					"enum": [
						"Button",
						"Calendar",
						"ColumnContainer",
						"Dropdown",
						"Heading",
						"Text",
						"TextAction",
						"TextExpand",
						"InlinePicker",
						"Map",
						"InputList",
						"Input",
						"ListContainer",
						"ListItem",
						"Search",
						"PhotoGallery",
						"SelectPhoto",
						"SelectSegmentContainer",
						"TextArea",
						"TextSelect",
						"TimeslotPicker"
					]
				},
				"source": {
					"type": "string"
				},
				"destination": {
					"type": "string"
				},
				"actions": {
					"type": "array",
					"default": [],
					"items": {
						"$ref": "#/$defs/UI_RowAction"
					}
				},
				"visible": {
					"type": "string"
				},
				"title": {
					"type": "string"
				},
				"label": {
					"type": "string"
				},
				"expandLabel": {
					"type": "string"
				},
				"text": {
					"type": "string"
				},
				"value": {
					"type": "string"
				},
				"placeholder": {
					"type": "string"
				},
				"format": {
					"type": "string"
				},
				"child": {
					"$ref": "#/$defs/UI_Row"
				},
				"action": {
					"type": "string"
				},
				"start_time": {
					"type": "string"
				},
				"end_time": {
					"type": "string"
				},
				"timeslot_interval_minutes": {
					"type": "integer"
				},
				"label_interval_minutes": {
					"type": "integer"
				},
				"header_format": {
					"type": "string"
				},
				"header_subtitle": {
					"type": "string"
				},
				"timeslot_format": {
					"type": "string"
				},
				"subtitle": {
					"type": "string"
				},
				"location": {
					"type": "string"
				},
				"icon": {
					"type": "string"
				},
				"image": {
					"type": "string"
				},
				"content": {
					"type": "string"
				},
				"photos": {
					"type": "string"
				},
				"children": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/UI_Row"
					}
				},
				"segments": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"name": {
					"type": "string"
				}
			}
		},
		"UI_RowAction": {
			"type": "object",
			"additionalProperties": false,
			"required": ["condition", "false", "true"],
			"properties": {
				"condition": {
					"type": "string"
				},
				"false": {
					"type": "string"
				},
				"true": {
					"type": "string"
				}
			}
		}
	}
}
