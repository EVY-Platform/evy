{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "sdui",
	"title": "UI_Flow",
	"description": "UI types: UI_Flow, UI_Page, UI_Row",
	"type": "object",
	"additionalProperties": false,
	"required": ["id", "name", "pages"],
	"properties": {
		"id": {
			"type": "string",
			"format": "uuid"
		},
		"name": {
			"type": "string",
			"minLength": 1
		},
		"submits": {
			"description": "Domain entity this flow submits via create(...,submit).",
			"type": "object",
			"additionalProperties": false,
			"required": ["service", "resource"],
			"properties": {
				"service": {
					"type": "string",
					"format": "uuid"
				},
				"resource": {
					"type": "string",
					"minLength": 1
				}
			}
		},
		"pages": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/UI_Page"
			}
		}
	},
	"$defs": {
		"UI_Page": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "title", "rows", "name"],
			"properties": {
				"id": {
					"type": "string",
					"format": "uuid"
				},
				"title": {
					"type": "string"
				},
				"rows": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/UI_Row"
					}
				},
				"footer": {
					"$ref": "#/$defs/UI_Row"
				},
				"name": {
					"type": "string",
					"minLength": 1
				}
			}
		},
		"UI_RowBase": {
			"type": "object",
			"required": ["id", "type", "actions", "visible", "name"],
			"properties": {
				"id": {
					"type": "string",
					"format": "uuid"
				},
				"type": {
					"type": "string",
					"enum": [
						"Button",
						"Calendar",
						"HorizontalContainer",
						"Dropdown",
						"Heading",
						"Text",
						"TextAction",
						"TextExpand",
						"InlinePicker",
						"Map",
						"InputList",
						"Input",
						"VerticalContainer",
						"ListItem",
						"Search",
						"PhotoGallery",
						"SelectPhoto",
						"TabContainer",
						"TextArea",
						"TextSelect",
						"TimeslotPicker"
					]
				},
				"actions": {
					"$ref": "#/$defs/UI_RowActions",
					"default": {}
				},
				"visible": {
					"type": "string"
				},
				"title": {
					"type": "string"
				},
				"name": {
					"type": "string",
					"minLength": 1
				},
				"sheet": {
					"$ref": "#/$defs/UI_Row"
				}
			}
		},
		"UI_Row": {
			"oneOf": [
				{
					"$ref": "definitions/Button.schema.json"
				},
				{
					"$ref": "definitions/Calendar.schema.json"
				},
				{
					"$ref": "definitions/HorizontalContainer.schema.json"
				},
				{
					"$ref": "definitions/Dropdown.schema.json"
				},
				{
					"$ref": "definitions/Heading.schema.json"
				},
				{
					"$ref": "definitions/Text.schema.json"
				},
				{
					"$ref": "definitions/TextAction.schema.json"
				},
				{
					"$ref": "definitions/TextExpand.schema.json"
				},
				{
					"$ref": "definitions/InlinePicker.schema.json"
				},
				{
					"$ref": "definitions/Map.schema.json"
				},
				{
					"$ref": "definitions/InputList.schema.json"
				},
				{
					"$ref": "definitions/Input.schema.json"
				},
				{
					"$ref": "definitions/VerticalContainer.schema.json"
				},
				{
					"$ref": "definitions/ListItem.schema.json"
				},
				{
					"$ref": "definitions/Search.schema.json"
				},
				{
					"$ref": "definitions/PhotoGallery.schema.json"
				},
				{
					"$ref": "definitions/SelectPhoto.schema.json"
				},
				{
					"$ref": "definitions/TabContainer.schema.json"
				},
				{
					"$ref": "definitions/TextArea.schema.json"
				},
				{
					"$ref": "definitions/TextSelect.schema.json"
				},
				{
					"$ref": "definitions/TimeslotPicker.schema.json"
				}
			]
		},
		"UI_RowActions": {
			"type": "object",
			"additionalProperties": false,
			"default": {},
			"properties": {
				"tap": {
					"type": "array",
					"items": {
						"$ref": "action.schema.json"
					}
				},
				"delete": {
					"type": "array",
					"items": {
						"$ref": "action.schema.json"
					}
				},
				"tap-row": {
					"type": "array",
					"items": {
						"$ref": "action.schema.json"
					}
				},
				"tap-column": {
					"type": "array",
					"items": {
						"$ref": "action.schema.json"
					}
				},
				"swipe-left": {
					"type": "array",
					"items": {
						"$ref": "action.schema.json"
					}
				},
				"submit": {
					"type": "array",
					"items": {
						"$ref": "action.schema.json"
					}
				}
			}
		}
	}
}
