{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "sdui",
	"title": "UI_Flow",
	"description": "UI types: UI_Flow, UI_Page, UI_Row",
	"type": "object",
	"additionalProperties": false,
	"required": ["id", "name", "pages"],
	"properties": {
		"id": {
			"type": "string",
			"format": "uuid"
		},
		"name": {
			"type": "string",
			"minLength": 1
		},
		"submits": {
			"description": "Domain entity this flow submits via create(...,submit).",
			"type": "object",
			"additionalProperties": false,
			"required": ["resource"],
			"properties": {
				"resource": {
					"$ref": "../common/rpc.schema.json#/$defs/ResourceRef"
				}
			}
		},
		"pages": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/UI_Page"
			}
		}
	},
	"$defs": {
		"UI_Page": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "title", "rows", "name"],
			"properties": {
				"id": {
					"type": "string",
					"format": "uuid"
				},
				"title": {
					"type": "string"
				},
				"rows": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/UI_Row"
					}
				},
				"footer": {
					"$ref": "#/$defs/UI_Row"
				},
				"name": {
					"type": "string",
					"minLength": 1
				}
			}
		},
		"UI_RowBase": {
			"type": "object",
			"required": ["id", "type", "actions", "visible", "name"],
			"properties": {
				"id": {
					"type": "string",
					"format": "uuid"
				},
				"type": {
					"type": "string",
					"enum": [
						"button",
						"calendar",
						"horizontal_container",
						"dropdown",
						"heading",
						"text",
						"text_action",
						"text_expand",
						"inline_picker",
						"map",
						"input_list",
						"input",
						"vertical_container",
						"list_item",
						"search",
						"photo_gallery",
						"select_photo",
						"tab_container",
						"text_area",
						"text_select",
						"timeslot_picker"
					]
				},
				"actions": {
					"$ref": "#/$defs/UI_RowActions",
					"default": {}
				},
				"visible": {
					"type": "string"
				},
				"title": {
					"type": "string"
				},
				"name": {
					"type": "string",
					"minLength": 1
				},
				"sheet": {
					"$ref": "#/$defs/UI_Row"
				}
			}
		},
		"UI_Row": {
			"oneOf": [
				{
					"$ref": "definitions/button.schema.json"
				},
				{
					"$ref": "definitions/calendar.schema.json"
				},
				{
					"$ref": "definitions/horizontal_container.schema.json"
				},
				{
					"$ref": "definitions/dropdown.schema.json"
				},
				{
					"$ref": "definitions/heading.schema.json"
				},
				{
					"$ref": "definitions/text.schema.json"
				},
				{
					"$ref": "definitions/text_action.schema.json"
				},
				{
					"$ref": "definitions/text_expand.schema.json"
				},
				{
					"$ref": "definitions/inline_picker.schema.json"
				},
				{
					"$ref": "definitions/map.schema.json"
				},
				{
					"$ref": "definitions/input_list.schema.json"
				},
				{
					"$ref": "definitions/input.schema.json"
				},
				{
					"$ref": "definitions/vertical_container.schema.json"
				},
				{
					"$ref": "definitions/list_item.schema.json"
				},
				{
					"$ref": "definitions/search.schema.json"
				},
				{
					"$ref": "definitions/photo_gallery.schema.json"
				},
				{
					"$ref": "definitions/select_photo.schema.json"
				},
				{
					"$ref": "definitions/tab_container.schema.json"
				},
				{
					"$ref": "definitions/text_area.schema.json"
				},
				{
					"$ref": "definitions/text_select.schema.json"
				},
				{
					"$ref": "definitions/timeslot_picker.schema.json"
				}
			]
		},
		"UI_RowActions": {
			"type": "object",
			"additionalProperties": false,
			"default": {},
			"properties": {
				"tap": {
					"type": "array",
					"items": {
						"$ref": "action.schema.json"
					}
				},
				"delete": {
					"type": "array",
					"items": {
						"$ref": "action.schema.json"
					}
				},
				"tap_row": {
					"type": "array",
					"items": {
						"$ref": "action.schema.json"
					}
				},
				"tap_column": {
					"type": "array",
					"items": {
						"$ref": "action.schema.json"
					}
				},
				"swipe_left": {
					"type": "array",
					"items": {
						"$ref": "action.schema.json"
					}
				},
				"submit": {
					"type": "array",
					"items": {
						"$ref": "action.schema.json"
					}
				}
			}
		}
	}
}
