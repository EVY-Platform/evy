			"id": "ast-convert-update-store",
			"category": "action-ast-convert",
			"platforms": ["web"],
			"input": "{update(66b092ae-7cd8-4d67-95b7-30b03568fd90,items,{id: item.id},{status: accepted})}",
			"expect": {
				"ast": {
					"fn": "update",
					"service": "66b092ae-7cd8-4d67-95b7-30b03568fd90",
					"resource": "items",
					"mode": "store",
					"filter": {
						"id": "item.id"
					},
					"changes": {
						"status": "accepted"
					}
				}
			}
		},
		{
			"id": "ast-convert-update-draft",
			"category": "action-ast-convert",
			"platforms": ["web"],
			"input": "{update(66b092ae-7cd8-4d67-95b7-30b03568fd90,items,{},{a: b},draft)}",
			"expect": {
				"ast": {
					"fn": "update",
					"service": "66b092ae-7cd8-4d67-95b7-30b03568fd90",
					"resource": "items",
					"mode": "draft",
					"changes": {
						"a": "b"
					}
				}
			},
			"notes": "The bare `draft` keyword becomes a typed mode; the empty filter slot disappears."
		},
		{
			"id": "ast-convert-rejects-bare-name",
			"category": "action-ast-convert",
			"platforms": ["web"],
			"input": "close()",
			"expect": {
