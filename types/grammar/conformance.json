{
	"$comment": "Executable reference for the EVY expression + action grammar. See README.md. Any parser behaviour change must update these vectors in the same commit.",
	"vectors": [
		{
			"id": "split-args-single",
			"category": "split-args",
			"platforms": ["ios", "web"],
			"input": "a",
			"expect": {
				"args": ["a"]
			}
		},
		{
			"id": "split-args-empty-string",
			"category": "split-args",
			"platforms": ["ios", "web"],
			"input": "",
			"expect": {
				"args": []
			}
		},
		{
			"id": "split-args-plain-pair",
			"category": "split-args",
			"platforms": ["ios", "web"],
			"input": "a,b",
			"expect": {
				"args": ["a", "b"]
			}
		},
		{
			"id": "split-args-trims-surrounding-space",
			"category": "split-args",
			"platforms": ["ios", "web"],
			"input": "a , b",
			"expect": {
				"args": ["a", "b"]
			}
		},
		{
			"id": "split-args-respects-nested-parens",
			"category": "split-args",
			"platforms": ["ios", "web"],
			"input": "formatDatetime(x, HH:mm),b",
			"expect": {
				"args": ["formatDatetime(x, HH:mm)", "b"]
			},
			"notes": "A comma inside a nested call is not a separator."
		},
		{
			"id": "split-args-respects-braces",
			"category": "split-args",
			"platforms": ["ios", "web"],
			"input": "a,{k: v, j: w},c",
			"expect": {
				"args": ["a", "{k: v, j: w}", "c"]
			},
			"notes": "Plain-text objects are one argument."
		},
		{
			"id": "split-args-respects-quotes",
			"category": "split-args",
			"platforms": ["ios", "web"],
			"input": "a,\"x,y\",c",
			"expect": {
				"args": ["a", "\"x,y\"", "c"]
			},
			"notes": "Quoted commas are literal. Quotes are legal in action args, unlike in comparison blocks."
		},
		{
			"id": "split-args-respects-brackets",
			"category": "split-args",
			"platforms": ["ios", "web"],
			"input": "a,[x, y],c",
			"expect": {
				"args": ["a", "[x, y]", "c"]
			},
			"notes": "Array literals (navigate query values) are one argument."
		},
		{
			"id": "comparison-numeric-gt-true",
			"category": "comparison",
			"platforms": ["ios"],
			"input": "{1 > 0}",
			"expect": {
				"value": true
			}
		},
		{
			"id": "comparison-numeric-gt-false",
			"category": "comparison",
			"platforms": ["ios"],
			"input": "{0 > 1}",
			"expect": {
				"value": false
			}
		},
		{
			"id": "comparison-or-combinator",
			"category": "comparison",
			"platforms": ["ios"],
			"input": "{0 > 1 || 1 > 0}",
			"expect": {
				"value": true
			}
		},
		{
			"id": "comparison-and-combinator",
			"category": "comparison",
			"platforms": ["ios"],
			"input": "{1 > 0 && 0 > 1}",
			"expect": {
				"value": false
			}
		},
		{
			"id": "comparison-grouping-parens",
			"category": "comparison",
			"platforms": ["ios"],
			"input": "{(1 > 0 && 2 > 1) || 0 > 1}",
			"expect": {
				"value": true
			}
		},
		{
			"id": "comparison-standalone-true",
			"category": "comparison",
			"platforms": ["ios"],
			"input": "{true}",
			"expect": {
				"value": true
			},
			"notes": "Boolean literals are valid standalone conditions (sdui.md). Resolved before path resolution."
		},
		{
			"id": "comparison-standalone-false",
			"category": "comparison",
			"platforms": ["ios"],
			"input": "{false}",
			"expect": {
				"value": false
			}
		},
		{
			"id": "comparison-boolean-atom-in-group",
			"category": "comparison",
			"platforms": ["ios"],
			"input": "{true && 1 > 0}",
			"expect": {
				"value": true
			},
			"notes": "A bare boolean is a valid atom inside a group. Web twin: condition-parse-boolean-atom-in-group."
		},
		{
			"id": "comparison-unquoted-literal-match",
			"category": "comparison",
			"platforms": ["ios"],
			"input": "{status_holder.status == pending}",
			"data": {
				"status_holder": {
					"status": "pending"
				}
			},
			"expect": {
				"value": true
			},
			"notes": "Unquoted bare words are the supported way to write string literals in comparisons."
		},
		{
			"id": "comparison-unquoted-literal-mismatch",
			"category": "comparison",
			"platforms": ["ios"],
			"input": "{status_holder.status == accepted}",
			"data": {
				"status_holder": {
					"status": "pending"
				}
			},
			"expect": {
				"value": false
			}
		},
		{
			"id": "comparison-quoted-literal-never-matches",
			"category": "comparison",
			"platforms": ["ios"],
			"input": "{status_holder.status == \"pending\"}",
			"data": {
				"status_holder": {
					"status": "pending"
				}
			},
			"expect": {
				"value": false
			},
			"notes": "WART: quotes are excluded by the comparison regex, so the block is never evaluated and the condition reads false even though the values are equal. docs/evy/functions.md warns about this."
		},
		{
			"id": "comparison-count-function-operand",
			"category": "comparison",
			"platforms": ["ios"],
			"input": "{count(list_holder) > 1}",
			"data": {
				"list_holder": ["a", "b"]
			},
			"expect": {
				"value": true
			}
		},
		{
			"id": "comparison-length-of-string",
			"category": "comparison",
			"platforms": ["ios"],
			"input": "{length(title_holder) > 0}",
			"data": {
				"title_holder": "Hello"
			},
			"expect": {
				"value": true
			}
		},
		{
			"id": "expression-length-of-string",
			"category": "expression",
			"platforms": ["ios"],
			"input": "{length(title_holder)}",
			"data": {
				"title_holder": "Hello"
			},
			"expect": {
				"text": "5"
			},
			"notes": "length counts characters."
		},
		{
			"id": "expression-length-of-array-is-zero",
			"category": "expression",
			"platforms": ["ios"],
			"input": "{length(list_holder)}",
			"data": {
				"list_holder": ["a", "b", "c"]
			},
			"expect": {
				"text": "0"
			},
			"notes": "length is string-only; non-strings count as 0 (functions.md). Use count for collections."
		},
		{
			"id": "expression-length-of-number-is-zero",
			"category": "expression",
			"platforms": ["ios"],
			"input": "{length(num_holder)}",
			"data": {
				"num_holder": 42
			},
			"expect": {
				"text": "0"
			},
			"notes": "length must not echo a numeric argument back."
		},
		{
			"id": "expression-length-of-missing-is-zero",
			"category": "expression",
			"platforms": ["ios"],
			"input": "{length(definitely_missing_root)}",
			"expect": {
				"text": "0"
			}
		},
		{
			"id": "expression-count-of-string-counts-characters",
			"category": "expression",
			"platforms": ["ios"],
			"input": "{count(title_holder)}",
			"data": {
				"title_holder": "Hello"
			},
			"expect": {
				"text": "5"
			},
			"notes": "count keeps its documented polymorphic behaviour; only length is narrowed."
		},
		{
			"id": "expression-count-of-number-echoes-it",
			"category": "expression",
			"platforms": ["ios"],
			"input": "{count(num_holder)}",
			"data": {
				"num_holder": 42
			},
			"expect": {
				"text": "42"
			},
			"notes": "count returns the number itself (functions.md)."
		},
		{
			"id": "comparison-missing-path-is-false",
			"category": "comparison",
			"platforms": ["ios"],
			"input": "{count(definitely_missing_root) > 0}",
			"expect": {
				"value": false
			},
			"notes": "Unresolvable paths count as 0 rather than erroring."
		},
		{
			"id": "expression-plain-text-passthrough",
			"category": "expression",
			"platforms": ["ios"],
			"input": "plain text",
			"expect": {
				"text": "plain text"
			}
		},
		{
			"id": "expression-simple-path",
			"category": "expression",
			"platforms": ["ios"],
			"input": "{title_holder}",
			"data": {
				"title_holder": "Hello"
			},
			"expect": {
				"text": "Hello"
			}
		},
		{
			"id": "expression-nested-path",
			"category": "expression",
			"platforms": ["ios"],
			"input": "{item_holder.name}",
			"data": {
				"item_holder": {
					"name": "Chair"
				}
			},
			"expect": {
				"text": "Chair"
			}
		},
		{
			"id": "expression-interpolated-in-sentence",
			"category": "expression",
			"platforms": ["ios"],
			"input": "Hello {title_holder}!",
			"data": {
				"title_holder": "world"
			},
			"expect": {
				"text": "Hello world!"
			}
		},
		{
			"id": "expression-array-index-sugar",
			"category": "expression",
			"platforms": ["ios"],
			"input": "{list_holder[1]}",
			"data": {
				"list_holder": ["a", "b"]
			},
			"expect": {
				"text": "b"
			}
		},
		{
			"id": "expression-count-function",
			"category": "expression",
			"platforms": ["ios"],
			"input": "{count(list_holder)}",
			"data": {
				"list_holder": ["a", "b", "c"]
			},
			"expect": {
				"text": "3"
			}
		},
		{
			"id": "expression-format-decimal",
			"category": "expression",
			"platforms": ["ios"],
			"input": "{formatDecimal(num_holder, 2)}",
			"data": {
				"num_holder": 20.0423
			},
			"expect": {
				"text": "20.04"
			}
		},
		{
			"id": "expression-format-datetime",
			"category": "expression",
			"platforms": ["ios"],
			"input": "{formatDatetime(when_holder, \"HH:mm\")}",
			"data": {
				"when_holder": "2024-01-19T12:42:52"
			},
			"expect": {
				"text": "12:42"
			},
			"notes": "Format patterns are quoted - the opposite of the comparison-block rule."
		},
		{
			"id": "expression-missing-root-throws",
			"category": "expression",
			"platforms": ["ios"],
			"input": "Hello {definitely_missing_root}!",
			"expect": {
				"error": true
			},
			"notes": "The core resolver throws on an unresolvable root. The display layer swallows it - see display-missing-root-blanks-whole-string."
		},
		{
			"id": "display-plain-text-passthrough",
			"category": "display",
			"platforms": ["ios"],
			"input": "plain text",
			"expect": {
				"text": "plain text"
			}
		},
		{
			"id": "display-resolves-path",
			"category": "display",
			"platforms": ["ios"],
			"input": "Hello {title_holder}!",
			"data": {
				"title_holder": "world"
			},
			"expect": {
				"text": "Hello world!"
			}
		},
		{
			"id": "display-missing-root-blanks-whole-string",
			"category": "display",
			"platforms": ["ios"],
			"input": "Hello {definitely_missing_root}!",
			"expect": {
				"text": ""
			},
			"notes": "WART: one unresolvable root empties the entire rendered string, including the literal text around it, instead of blanking just that token."
		},
		{
			"id": "condition-parse-simple-leaf",
			"category": "condition-parse",
			"platforms": ["web"],
			"input": "{a == b}",
			"expect": {
				"ast": {
					"kind": "leaf",
					"left": "a",
					"operator": "==",
					"right": "b"
				}
			}
		},
		{
			"id": "condition-parse-and-group",
			"category": "condition-parse",
			"platforms": ["web"],
			"input": "{a == b && c > d}",
			"expect": {
				"ast": {
					"kind": "group",
					"operator": "and",
					"children": [
						{
							"kind": "leaf",
							"left": "a",
							"operator": "==",
							"right": "b"
						},
						{
							"kind": "leaf",
							"left": "c",
							"operator": ">",
							"right": "d"
						}
					]
				}
			}
		},
		{
			"id": "condition-parse-empty-is-null",
			"category": "condition-parse",
			"platforms": ["web"],
			"input": "",
			"expect": {
				"ast": null
			},
			"notes": "An empty condition means always true; it has no AST."
		},
		{
			"id": "condition-parse-standalone-boolean-true",
			"category": "condition-parse",
			"platforms": ["web"],
			"input": "{true}",
			"expect": {
				"ast": {
					"kind": "boolean",
					"value": true
				}
			},
			"notes": "Standalone booleans round-trip through the editor. Parity with comparison-standalone-true."
		},
		{
			"id": "condition-parse-standalone-boolean-false",
			"category": "condition-parse",
			"platforms": ["web"],
			"input": "{false}",
			"expect": {
				"ast": {
					"kind": "boolean",
					"value": false
				}
			}
		},
		{
			"id": "condition-parse-boolean-atom-in-group",
			"category": "condition-parse",
			"platforms": ["web"],
			"input": "{true && a > b}",
			"expect": {
				"ast": {
					"kind": "group",
					"operator": "and",
					"children": [
						{
							"kind": "boolean",
							"value": true
						},
						{
							"kind": "leaf",
							"left": "a",
							"operator": ">",
							"right": "b"
						}
					]
				}
			},
			"notes": "A bare boolean is a valid atom inside a group, matching iOS _evaluateBooleanExpression."
		},
		{
			"id": "condition-parse-boolean-word-as-operand",
			"category": "condition-parse",
			"platforms": ["web"],
			"input": "{true == a}",
			"expect": {
				"ast": {
					"kind": "leaf",
					"left": "true",
					"operator": "==",
					"right": "a"
				}
			},
			"notes": "A boolean word followed by a comparison operator is an operand, not a standalone boolean."
		},
		{
			"id": "ast-convert-close",
			"category": "action-ast-convert",
			"platforms": ["web"],
			"input": "{close()}",
			"expect": {
				"ast": {
					"fn": "close"
				}
			}
		},
		{
			"id": "ast-convert-show",
			"category": "action-ast-convert",
			"platforms": ["web"],
			"input": "{show(b8c7d6e5-f4a3-4b2c-9d1e-0f8a7b6c5d4e)}",
			"expect": {
				"ast": {
					"fn": "show",
					"rowId": "b8c7d6e5-f4a3-4b2c-9d1e-0f8a7b6c5d4e"
				}
			}
		},
		{
			"id": "ast-convert-select-datum",
			"category": "action-ast-convert",
			"platforms": ["web"],
			"input": "{select($datum)}",
			"expect": {
				"ast": {
					"fn": "select",
					"value": "$datum"
				}
			}
		},
		{
			"id": "ast-convert-navigate-query",
			"category": "action-ast-convert",
			"platforms": ["web"],
			"input": "{navigate(flow-1,page-1,{id: $datum.id})}",
			"expect": {
				"ast": {
					"fn": "navigate",
					"flowId": "flow-1",
					"pageId": "page-1",
					"query": {
						"id": "$datum.id"
					}
				}
			}
		},
		{
			"id": "ast-convert-create-submit",
			"category": "action-ast-convert",
			"platforms": ["web"],
			"input": "{create(66b092ae-7cd8-4d67-95b7-30b03568fd90,items,submit)}",
			"expect": {
				"ast": {
					"fn": "create",
					"service": "66b092ae-7cd8-4d67-95b7-30b03568fd90",
					"resource": "items",
					"mode": "submit"
				}
			},
			"notes": "The bare `submit` keyword becomes a typed mode."
		},
		{
			"id": "ast-convert-create-inline-quoted",
			"category": "action-ast-convert",
			"platforms": ["web"],
			"input": "{create(66b092ae-7cd8-4d67-95b7-30b03568fd90,messages,{status: \"pending\", type: pickup})}",
			"expect": {
				"ast": {
					"fn": "create",
					"service": "66b092ae-7cd8-4d67-95b7-30b03568fd90",
					"resource": "messages",
					"mode": "inline",
					"data": {
						"status": "\"pending\"",
						"type": "pickup"
					}
				}
			},
			"notes": "Value expressions cross over verbatim, quotes included: whether `pickup` is a path or a literal is decided at execution, not at conversion."
		},
		{
			"id": "ast-convert-create-from-path",
			"category": "action-ast-convert",
			"platforms": ["web"],
			"input": "{create(core,addresses,pickup_address,{pickup_address.id})}",
			"expect": {
				"ast": {
					"fn": "create",
					"service": "core",
					"resource": "addresses",
					"mode": "fromPath",
					"dataPath": "pickup_address",
					"idDestination": "{pickup_address.id}"
				}
			}
		},
		{
			"id": "ast-convert-update-store",
			"category": "action-ast-convert",
			"platforms": ["web"],
			"input": "{update(66b092ae-7cd8-4d67-95b7-30b03568fd90,items,{id: item.id},{status: accepted})}",
			"expect": {
				"ast": {
					"fn": "update",
					"service": "66b092ae-7cd8-4d67-95b7-30b03568fd90",
					"resource": "items",
					"mode": "store",
					"filter": {
						"id": "item.id"
					},
					"changes": {
						"status": "accepted"
					}
				}
			}
		},
		{
			"id": "ast-convert-update-draft",
			"category": "action-ast-convert",
			"platforms": ["web"],
			"input": "{update(66b092ae-7cd8-4d67-95b7-30b03568fd90,items,{},{a: b},draft)}",
