{
	"$comment": "Executable reference for the EVY expression + action grammar. See README.md. Any parser behaviour change must update these vectors in the same commit.",
	"vectors": [
		{
			"id": "split-args-single",
			"category": "split-args",
			"platforms": ["ios", "web"],
			"input": "a",
			"expect": {
				"args": ["a"]
			}
		},
		{
			"id": "split-args-empty-string",
			"category": "split-args",
			"platforms": ["ios", "web"],
			"input": "",
			"expect": {
				"args": []
			}
		},
		{
			"id": "split-args-plain-pair",
			"category": "split-args",
			"platforms": ["ios", "web"],
			"input": "a,b",
			"expect": {
				"args": ["a", "b"]
			}
		},
		{
			"id": "split-args-trims-surrounding-space",
			"category": "split-args",
			"platforms": ["ios", "web"],
			"input": "a , b",
			"expect": {
				"args": ["a", "b"]
			}
		},
		{
			"id": "split-args-respects-nested-parens",
			"category": "split-args",
			"platforms": ["ios", "web"],
			"input": "formatDatetime(x, HH:mm),b",
			"expect": {
				"args": ["formatDatetime(x, HH:mm)", "b"]
			},
			"notes": "A comma inside a nested call is not a separator."
		},
		{
			"id": "split-args-respects-braces",
			"category": "split-args",
			"platforms": ["ios", "web"],
			"input": "a,{k: v, j: w},c",
			"expect": {
				"args": ["a", "{k: v, j: w}", "c"]
			},
			"notes": "Plain-text objects are one argument."
		},
		{
			"id": "split-args-respects-quotes",
			"category": "split-args",
			"platforms": ["ios", "web"],
			"input": "a,\"x,y\",c",
			"expect": {
				"args": ["a", "\"x,y\"", "c"]
			},
			"notes": "Quoted commas are literal. Quotes are legal in action args, unlike in comparison blocks."
		},
		{
			"id": "split-args-respects-brackets",
			"category": "split-args",
			"platforms": ["ios", "web"],
			"input": "a,[x, y],c",
			"expect": {
				"args": ["a", "[x, y]", "c"]
			},
			"notes": "Array literals (navigate query values) are one argument."
		},
		{
			"id": "comparison-numeric-gt-true",
			"category": "comparison",
			"platforms": ["ios"],
			"input": "{1 > 0}",
			"expect": {
				"value": true
			}
		},
		{
			"id": "comparison-numeric-gt-false",
			"category": "comparison",
			"platforms": ["ios"],
			"input": "{0 > 1}",
			"expect": {
				"value": false
			}
		},
		{
			"id": "comparison-or-combinator",
			"category": "comparison",
			"platforms": ["ios"],
			"input": "{0 > 1 || 1 > 0}",
			"expect": {
				"value": true
			}
		},
		{
			"id": "comparison-and-combinator",
			"category": "comparison",
			"platforms": ["ios"],
			"input": "{1 > 0 && 0 > 1}",
			"expect": {
				"value": false
			}
		},
		{
			"id": "comparison-grouping-parens",
			"category": "comparison",
			"platforms": ["ios"],
			"input": "{(1 > 0 && 2 > 1) || 0 > 1}",
			"expect": {
				"value": true
			}
		},
		{
			"id": "comparison-standalone-true",
			"category": "comparison",
			"platforms": ["ios"],
			"input": "{true}",
			"expect": {
				"value": true
			},
			"notes": "Boolean literals are valid standalone conditions (sdui.md). Resolved before path resolution."
		},
		{
			"id": "comparison-standalone-false",
			"category": "comparison",
			"platforms": ["ios"],
			"input": "{false}",
			"expect": {
				"value": false
			}
		},
		{
			"id": "comparison-boolean-atom-in-group",
			"category": "comparison",
			"platforms": ["ios"],
			"input": "{true && 1 > 0}",
			"expect": {
				"value": true
			},
			"notes": "A bare boolean is a valid atom inside a group. Web twin: condition-parse-boolean-atom-in-group."
		},
		{
			"id": "comparison-unquoted-literal-match",
			"category": "comparison",
			"platforms": ["ios"],
			"input": "{status_holder.status == pending}",
			"data": {
				"status_holder": {
					"status": "pending"
				}
			},
			"expect": {
				"value": true
			},
			"notes": "Unquoted bare words are the supported way to write string literals in comparisons."
		},
		{
			"id": "comparison-unquoted-literal-mismatch",
			"category": "comparison",
			"platforms": ["ios"],
			"input": "{status_holder.status == accepted}",
			"data": {
				"status_holder": {
					"status": "pending"
				}
			},
			"expect": {
				"value": false
			}
		},
		{
			"id": "comparison-record-binding-matches-by-id",
			"category": "comparison",
			"platforms": ["ios"],
			"input": "{message_holder.fk == item_holder}",
			"data": {
				"message_holder": {
					"fk": "12401f50-cf1a-45d7-a112-2e68a2070466"
				},
				"item_holder": {
					"id": "12401f50-cf1a-45d7-a112-2e68a2070466",
					"title": "Amazing Fridge"
				}
			},
			"expect": {
				"value": true
			},
			"notes": "An operand that resolves to a record compares by its id, so a foreign key can be compared against a bound record. Same rule as the two-argument findFirst(collection, id) form. Without it the record stringifies to JSON and can never equal an id."
		},
		{
			"id": "comparison-record-binding-mismatched-id",
			"category": "comparison",
			"platforms": ["ios"],
			"input": "{message_holder.fk == item_holder}",
			"data": {
				"message_holder": {
					"fk": "12401f50-cf1a-45d7-a112-2e68a2070466"
				},
				"item_holder": {
					"id": "56e5da4b-5cf0-4a2c-9f0d-9e02c4c0f5a1",
					"title": "Amazing Freezer"
				}
			},
			"expect": {
				"value": false
			}
		},
		{
			"id": "comparison-record-binding-without-id",
			"category": "comparison",
			"platforms": ["ios"],
			"input": "{message_holder.fk == item_holder}",
			"data": {
				"message_holder": {
					"fk": ""
				},
				"item_holder": {
					"title": "Amazing Fridge"
				}
			},
			"expect": {
				"value": false
			},
			"notes": "A record with no usable id has no identity to compare, so it keeps its rendered form rather than matching on an empty string."
		},
		{
			"id": "comparison-collection-binding-is-not-an-identity",
			"category": "comparison",
			"platforms": ["ios"],
			"input": "{message_holder.fk == items_holder}",
			"data": {
				"message_holder": {
					"fk": "12401f50-cf1a-45d7-a112-2e68a2070466"
				},
				"items_holder": [
					{
						"id": "12401f50-cf1a-45d7-a112-2e68a2070466"
					}
				]
			},
			"expect": {
				"value": false
			},
			"notes": "A collection has no single identity, so identity comparison applies to records only."
		},
		{
			"id": "expression-find-first-matches-record-binding-by-id",
			"category": "expression",
			"platforms": ["ios"],
			"input": "{findFirst(messages_holder, fk == item_holder).status}",
			"data": {
				"messages_holder": [
					{
						"id": "3f4c1d2b-8a9e-4c7d-9b1f-5e6a7b8c9d01",
						"fk": "56e5da4b-5cf0-4a2c-9f0d-9e02c4c0f5a1"
					},
					{
						"id": "7a8b9c0d-1e2f-4a3b-8c4d-5e6f7a8b9c02",
						"fk": "12401f50-cf1a-45d7-a112-2e68a2070466",
						"status": "pending"
					}
				],
				"item_holder": {
					"id": "12401f50-cf1a-45d7-a112-2e68a2070466",
					"title": "Amazing Fridge"
				}
			},
			"expect": {
				"text": "pending"
			},
			"notes": "findFirst operands resolve through their own path, so identity comparison has to hold there too, not only in a top-level comparison."
		},
		{
			"id": "expression-record-binding-renders-json",
			"category": "expression",
			"platforms": ["ios"],
			"input": "{item_holder}",
			"data": {
				"item_holder": {
					"id": "12401f50-cf1a-45d7-a112-2e68a2070466"
				}
			},
			"expect": {
				"text": "{\"id\":\"12401f50-cf1a-45d7-a112-2e68a2070466\"}"
			},
			"notes": "Identity coercion is scoped to comparison operands. Rendering a record still shows the whole record, so a change to comparison cannot leak into display."
		},
		{
			"id": "comparison-quoted-literal-matches",
			"category": "comparison",
			"platforms": ["ios"],
			"input": "{status_holder.status == \"pending\"}",
			"data": {
				"status_holder": {
					"status": "pending"
				}
			},
			"expect": {
				"value": true
			},
			"notes": "A quoted operand is a string literal, never resolved as a data path. Same rule as findFirst operands and if() branches."
		},
		{
			"id": "comparison-quoted-literal-mismatch",
			"category": "comparison",
			"platforms": ["ios"],
			"input": "{status_holder.status == \"accepted\"}",
			"data": {
				"status_holder": {
					"status": "pending"
				}
			},
			"expect": {
				"value": false
			}
		},
		{
			"id": "comparison-quoted-literal-with-space",
			"category": "comparison",
			"platforms": ["ios"],
			"input": "{status_holder.status == \"in progress\"}",
			"data": {
				"status_holder": {
					"status": "in progress"
				}
			},
			"expect": {
				"value": true
			},
			"notes": "Quotes are what make a literal containing spaces expressible at all."
		},
		{
			"id": "comparison-quoted-operator-chars-are-literal",
			"category": "comparison",
			"platforms": ["ios"],
			"input": "{status_holder.status == \"a && b\"}",
			"data": {
				"status_holder": {
					"status": "a && b"
				}
			},
			"expect": {
				"value": true
			},
			"notes": "Combinators and comparison operators inside quotes do not split the expression."
		},
		{
			"id": "comparison-quoted-format-function-operand",
			"category": "comparison",
			"platforms": ["ios"],
			"input": "{formatDatetime(when_holder, \"HH:mm\") == 12:42}",
			"data": {
				"when_holder": "2024-01-19T12:42:52"
			},
			"expect": {
				"value": true
			},
			"notes": "A quoted format pattern no longer stops the block being recognised as a comparison."
		},
		{
			"id": "comparison-count-function-operand",
			"category": "comparison",
			"platforms": ["ios"],
			"input": "{count(list_holder) > 1}",
			"data": {
				"list_holder": ["a", "b"]
			},
			"expect": {
				"value": true
			}
		},
		{
			"id": "comparison-length-of-string",
			"category": "comparison",
			"platforms": ["ios"],
			"input": "{length(title_holder) > 0}",
			"data": {
				"title_holder": "Hello"
			},
			"expect": {
				"value": true
			}
		},
		{
			"id": "expression-length-of-string",
			"category": "expression",
			"platforms": ["ios"],
			"input": "{length(title_holder)}",
			"data": {
				"title_holder": "Hello"
			},
			"expect": {
				"text": "5"
			},
			"notes": "length counts characters."
		},
		{
			"id": "expression-length-of-array-is-zero",
			"category": "expression",
			"platforms": ["ios"],
			"input": "{length(list_holder)}",
			"data": {
				"list_holder": ["a", "b", "c"]
			},
			"expect": {
				"text": "0"
			},
			"notes": "length is string-only; non-strings count as 0 (methods.md). Use count for collections."
		},
		{
			"id": "expression-length-of-number-is-zero",
			"category": "expression",
			"platforms": ["ios"],
			"input": "{length(num_holder)}",
			"data": {
				"num_holder": 42
			},
			"expect": {
				"text": "0"
			},
			"notes": "length must not echo a numeric argument back."
		},
		{
			"id": "expression-length-of-missing-is-zero",
			"category": "expression",
			"platforms": ["ios"],
			"input": "{length(definitely_missing_root)}",
			"expect": {
				"text": "0"
			}
		},
		{
			"id": "expression-count-of-string-counts-characters",
			"category": "expression",
			"platforms": ["ios"],
			"input": "{count(title_holder)}",
			"data": {
				"title_holder": "Hello"
			},
			"expect": {
				"text": "5"
			},
			"notes": "count keeps its documented polymorphic behaviour; only length is narrowed."
		},
		{
			"id": "expression-count-of-number-echoes-it",
			"category": "expression",
			"platforms": ["ios"],
			"input": "{count(num_holder)}",
			"data": {
				"num_holder": 42
			},
			"expect": {
				"text": "42"
			},
			"notes": "count returns the number itself (methods.md)."
		},
		{
			"id": "comparison-missing-path-is-false",
			"category": "comparison",
			"platforms": ["ios"],
			"input": "{count(definitely_missing_root) > 0}",
			"expect": {
				"value": false
			},
			"notes": "Unresolvable paths count as 0 rather than erroring."
		},
		{
			"id": "expression-plain-text-passthrough",
			"category": "expression",
			"platforms": ["ios"],
			"input": "plain text",
			"expect": {
				"text": "plain text"
			}
		},
		{
			"id": "expression-simple-path",
			"category": "expression",
			"platforms": ["ios"],
			"input": "{title_holder}",
			"data": {
				"title_holder": "Hello"
			},
			"expect": {
				"text": "Hello"
			}
		},
		{
			"id": "expression-nested-path",
			"category": "expression",
			"platforms": ["ios"],
			"input": "{item_holder.name}",
			"data": {
				"item_holder": {
					"name": "Chair"
				}
			},
			"expect": {
				"text": "Chair"
			}
		},
		{
			"id": "expression-interpolated-in-sentence",
			"category": "expression",
			"platforms": ["ios"],
			"input": "Hello {title_holder}!",
			"data": {
				"title_holder": "world"
			},
			"expect": {
				"text": "Hello world!"
			}
		},
		{
			"id": "expression-array-index-sugar",
			"category": "expression",
			"platforms": ["ios"],
			"input": "{list_holder[1]}",
			"data": {
				"list_holder": ["a", "b"]
			},
			"expect": {
				"text": "b"
			}
		},
		{
			"id": "expression-count-function",
			"category": "expression",
			"platforms": ["ios"],
			"input": "{count(list_holder)}",
			"data": {
				"list_holder": ["a", "b", "c"]
			},
			"expect": {
				"text": "3"
			}
		},
		{
			"id": "expression-format-decimal",
			"category": "expression",
			"platforms": ["ios"],
			"input": "{formatDecimal(num_holder, 2)}",
			"data": {
				"num_holder": 20.0423
			},
			"expect": {
				"text": "20.04"
			}
		},
		{
			"id": "expression-format-datetime",
			"category": "expression",
			"platforms": ["ios"],
			"input": "{formatDatetime(when_holder, \"HH:mm\")}",
			"data": {
				"when_holder": "2024-01-19T12:42:52"
			},
			"expect": {
				"text": "12:42"
			},
			"notes": "Format patterns are quoted - the opposite of the comparison-block rule."
		},
		{
			"id": "expression-missing-root-throws",
			"category": "expression",
			"platforms": ["ios"],
			"input": "Hello {definitely_missing_root}!",
			"expect": {
				"error": true
			},
			"notes": "The core resolver throws on an unresolvable root. The display layer swallows it per token - see display-missing-root-blanks-only-token."
		},
		{
			"id": "display-plain-text-passthrough",
			"category": "display",
			"platforms": ["ios"],
			"input": "plain text",
			"expect": {
				"text": "plain text"
			}
		},
		{
			"id": "display-resolves-path",
			"category": "display",
			"platforms": ["ios"],
			"input": "Hello {title_holder}!",
			"data": {
				"title_holder": "world"
			},
			"expect": {
				"text": "Hello world!"
			}
		},
		{
			"id": "display-missing-root-blanks-only-token",
			"category": "display",
			"platforms": ["ios"],
			"input": "Hello {definitely_missing_root}!",
			"expect": {
				"text": "Hello !"
			},
			"notes": "An unresolvable token blanks to empty; the literal text around it survives. The core resolver still throws - see expression-missing-root-throws."
		},
		{
			"id": "display-partial-failure-keeps-resolved-tokens",
			"category": "display",
			"platforms": ["ios"],
			"input": "A {title_holder} B {definitely_missing_root} C",
			"data": {
				"title_holder": "Hello"
			},
			"expect": {
				"text": "A Hello B  C"
			},
			"notes": "Each token succeeds or blanks on its own. No whitespace collapsing, so the blanked token leaves a double space."
		},
		{
			"id": "condition-parse-simple-leaf",
			"category": "condition-parse",
			"platforms": ["web"],
			"input": "{a == b}",
			"expect": {
				"ast": {
					"kind": "leaf",
					"left": "a",
					"operator": "==",
					"right": "b"
				}
			}
		},
		{
			"id": "condition-parse-and-group",
			"category": "condition-parse",
			"platforms": ["web"],
			"input": "{a == b && c > d}",
			"expect": {
				"ast": {
					"kind": "group",
					"operator": "and",
					"children": [
						{
							"kind": "leaf",
							"left": "a",
							"operator": "==",
							"right": "b"
						},
						{
							"kind": "leaf",
							"left": "c",
							"operator": ">",
							"right": "d"
						}
					]
				}
			}
		},
		{
			"id": "condition-parse-quoted-literal",
			"category": "condition-parse",
			"platforms": ["web"],
			"input": "{a == \"x y\"}",
			"expect": {
				"ast": {
					"kind": "leaf",
					"left": "a",
					"operator": "==",
					"right": "\"x y\""
				}
			},
			"notes": "Quotes survive into the AST verbatim, like action-data values - whether a bare word is a path or a literal is decided at execution. A quoted run is one operand even with spaces in it."
		},
		{
			"id": "condition-parse-quoted-operator-chars",
			"category": "condition-parse",
			"platforms": ["web"],
			"input": "{a == \"x > y\"}",
			"expect": {
				"ast": {
					"kind": "leaf",
					"left": "a",
					"operator": "==",
					"right": "\"x > y\""
				}
			},
			"notes": "Operator characters inside quotes are literal text, not tokens."
		},
		{
			"id": "condition-parse-empty-is-null",
			"category": "condition-parse",
			"platforms": ["web"],
			"input": "",
			"expect": {
				"ast": null
			},
			"notes": "An empty condition means always true; it has no AST."
		},
		{
			"id": "condition-parse-standalone-boolean-true",
			"category": "condition-parse",
			"platforms": ["web"],
			"input": "{true}",
			"expect": {
				"ast": {
					"kind": "boolean",
					"value": true
				}
			},
			"notes": "Standalone booleans round-trip through the editor. Parity with comparison-standalone-true."
		},
		{
			"id": "condition-parse-standalone-boolean-false",
			"category": "condition-parse",
			"platforms": ["web"],
			"input": "{false}",
			"expect": {
				"ast": {
					"kind": "boolean",
					"value": false
				}
			}
		},
		{
			"id": "condition-parse-boolean-atom-in-group",
			"category": "condition-parse",
			"platforms": ["web"],
			"input": "{true && a > b}",
			"expect": {
				"ast": {
					"kind": "group",
					"operator": "and",
					"children": [
						{
							"kind": "boolean",
							"value": true
						},
						{
							"kind": "leaf",
							"left": "a",
							"operator": ">",
							"right": "b"
						}
					]
				}
			},
			"notes": "A bare boolean is a valid atom inside a group, matching iOS _evaluateBooleanExpression."
		},
		{
			"id": "condition-parse-boolean-word-as-operand",
			"category": "condition-parse",
			"platforms": ["web"],
			"input": "{true == a}",
			"expect": {
				"ast": {
