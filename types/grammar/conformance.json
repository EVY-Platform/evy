		{
			"id": "ast-convert-rejects-two-arg-create",
			"category": "action-ast-convert",
			"platforms": ["web"],
			"input": "{create(svc,items)}",
			"expect": {
				"ast": null
			},
			"notes": "A two-argument create was always invalid."
		},
		{
			"id": "ast-convert-rejects-store-update-without-filter",
			"category": "action-ast-convert",
			"platforms": ["web"],
			"input": "{update(svc,items,{},{a: b})}",
			"expect": {
				"ast": null
			},
			"notes": "Store mode requires a non-empty filter."
		},
		{
			"id": "expression-sort-scalar-asc-first",
			"category": "expression",
			"platforms": ["ios"],
			"input": "{findFirst(sort(times_holder, asc))}",
			"data": {
				"times_holder": [
					"2026-06-04T09:30:00",
					"2026-06-03T09:00:00",
					"2026-06-03T10:00:00"
				]
			},
			"expect": {
				"text": "2026-06-03T09:00:00"
			},
			"notes": "Scalar datetime strings sort chronologically via lexicographic asc."
		},
		{
			"id": "expression-sort-keyed-asc-missing-last",
			"category": "expression",
			"platforms": ["ios"],
			"input": "{findFirst(sort(records_holder, asc, price)).id}",
			"data": {
				"records_holder": [
					{ "id": "a", "price": 50 },
					{ "id": "b" },
					{ "id": "c", "price": 10 }
				]
			},
			"expect": {
				"text": "c"
			},
			"notes": "Missing/null keyed values are always last regardless of direction."
		},
		{
			"id": "expression-find-first-one-arg",
			"category": "expression",
			"platforms": ["ios"],
			"input": "{findFirst(records_holder).id}",
			"data": {
				"records_holder": [
					{ "id": "first", "value": "A" },
					{ "id": "second", "value": "B" }
				]
			},
			"expect": {
				"text": "first"
			}
