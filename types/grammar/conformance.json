			"id": "condition-parse-standalone-boolean-unrepresentable",
			"category": "condition-parse",
			"platforms": ["web"],
			"input": "{true}",
			"expect": {
				"ast": null
			},
			"notes": "WART: the web condition editor cannot represent a standalone boolean, so opening and saving such an action silently drops it - even though iOS evaluates it correctly (see comparison-standalone-true)."
		},
		{
			"id": "ast-convert-close",
			"category": "action-ast-convert",
			"platforms": ["web"],
			"input": "{close()}",
			"expect": {
				"ast": {
					"fn": "close"
				}
			}
